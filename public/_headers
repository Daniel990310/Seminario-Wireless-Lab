# Cabeceras HTTP del sitio.
#
# Este formato lo leen tanto Cloudflare Pages como Netlify, así que sirve para
# cualquiera de los dos sin cambios.

/*
  # Evita que el sitio se embeba en un iframe ajeno.
  X-Frame-Options: SAMEORIGIN
  # Impide que el navegador adivine tipos MIME distintos al declarado.
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # No se usa ninguna de estas APIs.
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Los archivos de /_astro llevan un hash en el nombre, así que un cambio de
# contenido cambia la URL. Se pueden cachear indefinidamente.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# El HTML debe revalidarse para que una corrección de contenido se vea al
# instante, sin esperar que expire una caché.
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate
