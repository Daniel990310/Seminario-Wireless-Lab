---
/**
 * Estado provisional de la sección de programa.
 *
 * Sin brillos ni haces decorativos: solo la etiqueta de estado y el aviso. El
 * único movimiento son los frentes de onda del fondo, que es el mismo motivo
 * físico del hero y no un adorno de interfaz.
 */
import { Ripple } from '~/components/ui/ripple';
import { seminar } from '~/data/seminar';

const { program, contact } = seminar;
---

<div class="surface relative overflow-hidden rounded-lg px-6 py-16 text-center sm:px-12 sm:py-24">
  <Ripple
    mainCircleSize={190}
    mainCircleOpacity={0.08}
    numCircles={6}
    className="text-signal-400/15"
  />

  <div class="relative mx-auto max-w-xl">
    <p class="eyebrow inline-flex items-center gap-2.5 text-mist-400">
      <span class="block size-1.5 rounded-full bg-signal-400/70" aria-hidden="true"></span>
      En preparación
    </p>

    <p class="mt-7 font-display text-xl font-semibold text-mist-100 sm:text-2xl">
      {program.pendingNotice}
    </p>
    <p class="mt-4 text-base leading-relaxed text-mist-400">{program.pendingDetail}</p>

    <a
      href={`mailto:${contact.email}?subject=${encodeURIComponent('Consulta por el programa — Beyond Connectivity 2026')}`}
      class="mt-8 inline-block text-sm font-medium text-signal-300 underline decoration-signal-400/40 underline-offset-4 transition-colors hover:decoration-signal-300"
    >
      Solicitar aviso de publicación
    </a>
  </div>
</div>
