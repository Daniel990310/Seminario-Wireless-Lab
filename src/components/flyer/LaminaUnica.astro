---
/**
 * Pieza única 4:5, de respaldo: para WhatsApp o para publicar sin carrusel.
 *
 * Lleva todo lo esencial en una lámina, y para que quepa a tamaño legible renuncia a lo
 * que el carrusel sí muestra: los retratos y las afiliaciones. Quedan los nombres, que es
 * lo que alguien reconoce en un feed, en una columna con el QR al lado.
 *
 * Con nombres en dos columnas y el QR en su propia fila desbordaba 283 px en español
 * `[medido: 2026-10-01]`: es la medida de por qué el feed va en carrusel.
 */
import type { Contenido } from '~/data/contenido';
import Encabezado from './Encabezado.astro';
import Marcas from './Marcas.astro';
import Qr from './Qr.astro';
import { datosFlyer } from './datos';

interface Props {
  c: Contenido;
}

const { c } = Astro.props;
const t = c.ui.flyer;
const { dominio, internacionales, nacionales } = datosFlyer(c);
const nombres = [...internacionales, ...nacionales].map((e) => e.name);
---

<Encabezado c={c} anchoLogo={400} compacto />

{/*
  Espaciado al justo: con la mención de financiamiento completa en la franja —ANID y
  CYTED, una línea más— la pieza desbordaba 39 px en inglés `[medido: 2026-10-02]`. Se
  recuperó en interlineado y márgenes, sin bajar ningún texto del piso.
*/}
<div class="mt-[24px] flex items-start justify-between gap-[40px]">
  <div class="min-w-0">
    <p class="eyebrow text-[31px]">{t.expositores}</p>
    <ul class="mt-[6px]">
      {nombres.map((n) => <li class="text-[31px] leading-[1.1] font-semibold text-foreground">{n}</li>)}
    </ul>
  </div>
  {c.registro.url && <Qr url={c.registro.url} tamano={220} rotulo={t.qr} anchoRotulo={340} lado="derecha" />}
</div>

<p class="mt-[12px] text-[40px] leading-none text-foreground">
  {t.inscripciones} <span class="font-semibold text-accent">{dominio}</span>
</p>

<Marcas c={c} />
