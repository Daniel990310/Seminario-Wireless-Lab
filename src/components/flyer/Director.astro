---
/**
 * Quien dirige el seminario, con retrato: el bloque de «El seminario» del sitio (RF-31)
 * llevado al pendón (RF-33.5). Mauricio pidió el 2026-10-04 aparecer como protagonista, y
 * Daniel, el 2026-10-14, su foto arriba como organizador «como hicimos en el sitio»: el
 * mismo marco circular, el mismo epígrafe y el mismo cargo, y el retrato más grande que el
 * de un expositor.
 *
 * El nombre va con el grado, en la forma de cada idioma (`datosFlyer`, `organizador`): es
 * lo que RF-25.2 busca en la lámina.
 *
 * Archivo original del retrato (800 px), no el reducido: se imprime.
 */
import type { Contenido } from '~/data/contenido';
import { datosFlyer } from './datos';

interface Props {
  c: Contenido;
  /** Diámetro del retrato, en px de lienzo. */
  retrato: number;
}

const { c, retrato } = Astro.props;
const { director } = c;
const { organizador } = datosFlyer(c);
---

<div class="flex items-center gap-[40px]">
  <img
    src={director.foto.src}
    alt=""
    width={director.foto.width}
    height={director.foto.height}
    class="shrink-0 rounded-full object-cover"
    style={`width:${retrato}px;height:${retrato}px`}
    data-flyer-director
  />
  <div class="min-w-0">
    <p class="eyebrow text-[31px] text-accent">{director.epigrafe}</p>
    <p class="mt-[10px] font-display text-[64px] leading-[1.05] font-semibold text-foreground">{organizador ?? director.nombre}</p>
    <p class="mt-[10px] text-[36px] leading-[1.2] text-muted-foreground">{director.cargo}</p>
  </div>
</div>
