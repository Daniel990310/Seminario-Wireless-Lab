---
/**
 * Lámina de expositores: segunda del carrusel y segunda historia.
 *
 * Una sola columna y no dos: a 40 px el nombre y a 32 la afiliación —por encima del piso
 * de 31—, dos columnas de 448 px partían nombres y afiliaciones en varias líneas. En una
 * columna cada expositor ocupa una fila y se lee de un vistazo.
 *
 * Sin franja de marcas, en los dos formatos: es una lámina interior, y la franja con la
 * mención de financiamiento va en las de portada e inscripción. En la historia se probó
 * con franja y no cabía sin apretar la lista ni sin pegar el último retrato al blanco
 * (Daniel, 2026-10-01). La historia tiene más alto, así que la lista crece y se reparte.
 *
 * Retrato si lo hay; monograma si no, igual que en el sitio (RF-11.2). Nada generado:
 * lo prohíbe el manual de ANID (§1.5) y el proyecto.
 */
import { Image } from 'astro:assets';
import type { Contenido } from '~/data/contenido';
import { iniciales } from '~/data/iniciales';
import Cabecera from './Cabecera.astro';
import { datosFlyer } from './datos';

interface Props {
  c: Contenido;
  /** 9:16: retratos de 96 px, texto un escalón más grande y la lista repartida en el alto. */
  historia?: boolean;
}

const { c, historia = false } = Astro.props;
const { internacionales, nacionales } = datosFlyer(c);
const grupos = [
  { rotulo: c.ui.flyer.grupoInternacional, lista: internacionales },
  { rotulo: c.ui.flyer.grupoNacional, lista: nacionales },
];
/* 96 en la historia: a 104 la lista desbordaba 21 px en inglés con el aire hasta la foto `[medido]`. */
const retrato = historia ? 'size-[96px]' : 'size-[88px]';
---

<Cabecera c={c} />
<h2 class="mt-[36px] font-display text-[84px] leading-none font-semibold text-foreground">{c.ui.flyer.expositores}</h2>

{/* `pb-[48px]`: aire entre el último retrato y la foto de la sede, que en la historia cierra la lámina. */}
<div class:list={['flex flex-col', historia && 'flex-1 justify-evenly pb-[48px]']}>
  {
    grupos.map((g) => (
      <section class="mt-[36px]">
        <p class="eyebrow text-[31px]">{g.rotulo}</p>
        <ul class:list={['mt-[16px] flex flex-col', historia ? 'gap-[16px]' : 'gap-[14px]']}>
          {g.lista.map((e) => (
            <li class="flex items-center gap-[24px]">
              {e.foto ? (
                <Image src={e.foto} alt="" width={208} height={208} class:list={[retrato, 'shrink-0 rounded-full object-cover']} />
              ) : (
                <span class:list={[retrato, 'flex shrink-0 items-center justify-center rounded-full bg-surface font-display text-[36px] font-semibold text-primary']}>
                  {iniciales(e.name)}
                </span>
              )}
              <span class="min-w-0">
                <span class:list={['block leading-[1.15] font-semibold text-foreground', historia ? 'text-[44px]' : 'text-[40px]']}>{e.name}</span>
                <span class:list={['block leading-[1.2] text-muted-foreground', historia ? 'text-[36px]' : 'text-[32px]']}>{e.afiliacionCorta}</span>
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>
