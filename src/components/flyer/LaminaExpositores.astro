---
/**
 * Lámina de expositores: segunda del carrusel y segunda historia.
 *
 * ── CUATRO COLUMNAS POR GRUPO (2026-10-08) ───────────────────────────────────────
 *
 * Hasta el 2026-10-08 iba en una sola columna con retratos de 88 px (96 en la historia): la
 * mitad derecha del lienzo quedaba vacía y las caras, que son lo que esta lámina vende,
 * eran lo más chico. Ahora cada grupo es una fila de cuatro con el retrato a 150 px y
 * nombre y afiliación debajo, partidos en renglones si hace falta. Ocho expositores son
 * cuatro y cuatro, así que los grupos quedan parejos. La historia usa la misma grilla, con
 * los grupos repartidos en el alto; con el texto un escalón más grande partía «Gil /
 * Zussman» y «Nokia / Bell Labs» en la columna de 216 px.
 *
 * Con franja de marcas y agradecimiento desde el 2026-10-09 (Daniel, a prueba), pero sin
 * la fila de participantes: con ella los retratos no cabían en dos filas. La franja les
 * quitó 28 px (192 → 164); antes no la llevaba por ser lámina interior. El 2026-10-13 el
 * agradecimiento ganó un renglón (seis proyectos ANID) y desbordaba 26 px `[medido]`: los
 * retratos bajan a 150.
 *
 * La grilla vive en `GrillaExpositores`, que comparte con el pendón.
 */
import type { Contenido } from '~/data/contenido';
import Cabecera from './Cabecera.astro';
import GrillaExpositores from './GrillaExpositores.astro';

interface Props {
  c: Contenido;
}

const { c } = Astro.props;
---

<Cabecera c={c} />
<h2 class="mt-[36px] font-display text-[84px] leading-none font-semibold text-foreground">{c.ui.flyer.expositores}</h2>

<div class="flex flex-1 flex-col justify-evenly">
  <GrillaExpositores c={c} retrato={150} />
</div>

