---
/**
 * Lámina de expositores: segunda del carrusel y segunda historia.
 *
 * ── CUATRO COLUMNAS POR GRUPO (2026-10-08) ───────────────────────────────────────
 *
 * Hasta el 2026-10-08 iba en una sola columna con retratos de 88 px (96 en la historia): la
 * mitad derecha del lienzo quedaba vacía y las caras, que son lo que esta lámina vende,
 * eran lo más chico. Ahora cada grupo es una fila de cuatro con el retrato a 164 px y
 * nombre y afiliación debajo, partidos en renglones si hace falta. Ocho expositores son
 * cuatro y cuatro, así que los grupos quedan parejos. La historia usa la misma grilla, con
 * los grupos repartidos en el alto; con el texto un escalón más grande partía «Gil /
 * Zussman» y «Nokia / Bell Labs» en la columna de 216 px.
 *
 * Con franja de marcas y agradecimiento desde el 2026-10-09 (Daniel, a prueba), pero sin
 * la fila de participantes: con ella los retratos no cabían en dos filas. La franja les
 * quitó 28 px (192 → 164); antes no la llevaba por ser lámina interior.
 *
 * Retrato si lo hay; monograma si no, igual que en el sitio (RF-11.2). Nada generado:
 * lo prohíbe el manual de ANID (§1.5) y el proyecto.
 */
import { Image } from 'astro:assets';
import type { Contenido } from '~/data/contenido';
import { iniciales } from '~/data/iniciales';
import Cabecera from './Cabecera.astro';
import Marcas from './Marcas.astro';
import { datosFlyer } from './datos';

interface Props {
  c: Contenido;
  /** Fila de participantes sobre la franja; la decide `LAMINAS` en `src/data/flyer.ts`. */
  participantes: boolean;
}

const { c, participantes } = Astro.props;
const { internacionales, nacionales } = datosFlyer(c);
const grupos = [
  { rotulo: c.ui.flyer.grupoInternacional, lista: internacionales },
  { rotulo: c.ui.flyer.grupoNacional, lista: nacionales },
];
---

<Cabecera c={c} />
<h2 class="mt-[36px] font-display text-[84px] leading-none font-semibold text-foreground">{c.ui.flyer.expositores}</h2>

<div class="flex flex-1 flex-col justify-evenly">
  {
    grupos.map((g) => (
      <section class="mt-[32px]">
        <p class="eyebrow text-[31px]">{g.rotulo}</p>
        <ul class="mt-[16px] grid grid-cols-4 gap-x-[24px]">
          {g.lista.map((e) => (
            <li class="flex flex-col">
              {e.foto ? (
                <Image src={e.foto} alt="" width={328} height={328} class="size-[164px] rounded-full object-cover" />
              ) : (
                <span class="flex size-[164px] items-center justify-center rounded-full bg-surface font-display text-[56px] font-semibold text-primary">
                  {iniciales(e.name)}
                </span>
              )}
              <span class="mt-[14px] min-w-0">
                <span class="block text-[34px] leading-[1.12] font-semibold text-balance text-foreground">{e.name}</span>
                <span class="mt-[4px] block text-[31px] leading-[1.15] text-balance text-muted-foreground">{e.afiliacionCorta}</span>
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<Marcas c={c} participantes={participantes} />
