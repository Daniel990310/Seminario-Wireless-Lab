---
/**
 * Arranque de las láminas de portada: rótulo, logo del seminario, lo que el título
 * oficial añade al logo, fecha y sede.
 *
 * El logo **es** el nombre: «Beyond Connectivity / Wireless Sensing» en trazados, con la
 * tipografía del manual 5.2. La primera versión ponía el nombre en Crimson Pro como
 * titular y el logo no aparecía, así que la pieza tenía dos identidades y ninguna era la
 * de la marca. Ahora el logo encabeza y el texto solo completa el título oficial.
 *
 * Variante `-blanco` porque el fondo es oscuro, como manda el manual. Su mínimo con
 * descriptor es 400 px de ancho; aquí va a `anchoLogo`, siempre por encima.
 */
import logoPrincipal from '~/assets/marca/logo-principal-blanco.svg';
import type { Contenido } from '~/data/contenido';
import { datosFlyer } from './datos';

interface Props {
  c: Contenido;
  anchoLogo: number;
  /**
   * La pieza única: fecha a 64 en vez de 76, organizador a 32 y menos aire. Con la escala
   * de portada desbordaba 97 px en inglés, donde el organizador ocupa dos líneas.
   */
  compacto?: boolean;
}

const { c, anchoLogo, compacto = false } = Astro.props;
const { restoTitulo, organizador } = datosFlyer(c);
/* Proporción del `viewBox` del logo, 650 × 218: no se estira (manual 5.2). */
const altoLogo = Math.round((anchoLogo * 218) / 650);
/*
 * El SVG trae su margen de respeto: la onda exterior empieza en x ≈ 31,5 de 650
 * `[medido sobre logo-principal-blanco.png, 2600 px]`. Se compensa para que el símbolo
 * quede alineado con el texto, y el margen sigue existiendo hacia arriba y hacia abajo.
 */
const sangria = Math.round((anchoLogo * 31.5) / 650);
---

<p class="eyebrow text-[31px]">{c.ui.hero.eyebrow}</p>
{/* El nombre accesible del lienzo es el título oficial, en el `<title>` y en el `alt`. */}
<img src={logoPrincipal.src} alt="" width={anchoLogo} height={altoLogo} class="mt-[12px] block" style={`margin-left:-${sangria}px`} data-logo-seminario="principal" />
<p class="mt-[8px] font-display text-[52px] leading-[1.1] text-balance text-primary">{restoTitulo}</p>
<p
  class:list={[
    'font-mono leading-none font-semibold tracking-tight text-accent',
    compacto ? 'mt-[24px] text-[64px]' : 'mt-[36px] text-[76px]',
  ]}
>
  {c.dates.shortLabel}
</p>
<p class="mt-[16px] text-[36px] leading-[1.2] text-balance text-muted-foreground">{c.venue.name}, {c.venue.country}</p>
{
  organizador && (
    <p
      class:list={[
        'leading-[1.2] text-balance text-muted-foreground',
        compacto ? 'mt-[12px] text-[32px]' : 'mt-[20px] text-[36px]',
      ]}
    >
      {c.ui.flyer.organiza}: <span class="font-semibold text-foreground">{organizador}</span>
    </p>
  )
}
