---
/**
 * Arranque de las láminas de portada: la marca del seminario (`MarcaSeminario`), fecha,
 * sede y organizador.
 */
import type { Contenido } from '~/data/contenido';
import MarcaSeminario from './MarcaSeminario.astro';
import { datosFlyer } from './datos';

interface Props {
  c: Contenido;
  anchoLogo: number;
  /**
   * Pieza única e historia: fecha a 64, organizador a 32 y menos aire. Con la escala de
   * portada desbordaba 97 px en inglés, donde el organizador ocupa dos líneas. Sin
   * `compacto` (la portada del carrusel), la fecha va a 100: con la franja estrecha
   * (2026-10-08) le sobraba alto, y es lo que quien pasa por el feed tiene que retener.
   */
  compacto?: boolean;
}

const { c, anchoLogo, compacto = false } = Astro.props;
const { organizador } = datosFlyer(c);
---

<MarcaSeminario c={c} anchoLogo={anchoLogo} />
<p
  class:list={[
    'font-mono leading-none font-semibold tracking-tight text-accent',
    compacto ? 'mt-[24px] text-[64px]' : 'mt-[40px] text-[100px]',
  ]}
>
  {c.dates.shortLabel}
</p>
<p class="mt-[16px] text-[36px] leading-[1.2] text-balance text-muted-foreground">{c.venue.name}, {c.venue.country}</p>
{
  organizador && (
    <p
      class:list={[
        'leading-[1.2] text-balance text-muted-foreground',
        compacto ? 'mt-[12px] text-[32px]' : 'mt-[20px] text-[36px]',
      ]}
    >
      {c.ui.flyer.organiza}: <span class="font-semibold text-foreground">{organizador}</span>
    </p>
  )
}
