---
/**
 * El laboratorio que organiza, en el lugar donde el pendón nombraba a Mauricio. Lo pidió él
 * el 2026-10-15, por Daniel: «cambiar mi nombre por el logo PUCV que dice nuestro
 * laboratorio», el de la plantilla del póster (`Poster_plantilla - Beyond Connectivity`).
 *
 * Ese logo solo existe como PNG de 799 × 223 px: impreso al tamaño de este bloque quedaría
 * en unos 35 ppi (RF-33.4 pide 90). Por eso se arma con sus dos partes, en la misma
 * disposición: el nombre del laboratorio en trazados vectoriales, alineado a la derecha en
 * dos renglones, y el escudo PUCV horizontal. El escudo es el monocromático oficial con la tinta en blanco,
 * la misma derivación que `pucvOscuro` en `comun.ts`, pero desde el archivo de 1297 px y no
 * desde el de 511. Cuando llegue el logo del laboratorio en vector, se reemplaza este bloque.
 *
 * Proporción: en la plantilla, la mayúscula del nombre mide el 10 % del alto del escudo.
 * Aquí, el 12 %: el nombre va como texto de 31 px, el piso de RF-24.1 (`CUERPO`), y el
 * escudo no pasa de 370 px de ancho, que es donde su archivo da 90 ppi impreso.
 *
 * Letra: el manual de Normas Gráficas PUCV 2023 (pág. 12, «Construcción de submarcas») pide
 * Modernica Heavy para el nombre de la unidad; Roboto es la corporativa para textos. Modernica
 * es comercial y los subconjuntos incrustados en el paquete oficial de submarcas no traen la W.
 * Onest 700 es la libre más parecida de 113 candidatas medidas contra esos glifos oficiales
 * (I R E L S C O M U N T A B): 0,879 de coincidencia de forma, ancho a ±3 % y peso a ±2,7 %
 * `[medido el 2026-10-15]`. Va en trazados (`wcl-nombre-blanco.svg`) y no como fuente: es un
 * logotipo, y la fuente sumaba 15,5 kB al sitio y pasaba el presupuesto de RNF-2.6. Con la
 * licencia de Modernica, se regenera ese SVG.
 */
import pucvBlanco from '~/assets/logos/pucv-monocromo-blanco.png';
import nombreLaboratorio from '~/assets/logos/wcl-nombre-blanco.svg';
import type { Contenido } from '~/data/contenido';
import ImagenFlyer from './ImagenFlyer.astro';
import { datosFlyer } from './datos';

interface Props {
  c: Contenido;
}

const { c } = Astro.props;
const { laboratorio } = datosFlyer(c);
/* El SVG está en unidades de la fuente, 1000 por em: a 31 px de cuerpo mide 1/1000 × 31. */
const CUERPO = 31;
const { width, height } = nombreLaboratorio;
---

<div>
  <p class="eyebrow text-[31px] text-accent">{c.ui.flyer.organiza}</p>
  <div class="mt-[24px] flex items-center gap-[28px]">
    <img
      src={nombreLaboratorio.src}
      alt={laboratorio}
      width={width}
      height={height}
      class="shrink-0"
      style={`width:${(width * CUERPO) / 1000}px;height:${(height * CUERPO) / 1000}px`}
    />
    <ImagenFlyer src={pucvBlanco} original class="shrink-0" style="width:370px;height:auto" />
  </div>
</div>
