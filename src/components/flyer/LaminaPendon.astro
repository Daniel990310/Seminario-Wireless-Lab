---
/**
 * Pendón roller impreso (RF-33): la identidad del seminario, para ponerlo de pie en esta
 * edición y en las siguientes.
 *
 * La primera versión (2026-10-14) juntaba todo el carrusel: expositores con retrato, fecha,
 * sede, QR de inscripción y horario. La revisión de diseño que Daniel reenvió el
 * 2026-10-15 lo corrigió: un pendón no cumple la función de un afiche; dice «este soy yo»,
 * y con los expositores y la fecha no sirve la vez siguiente. Que ganen espacio el logo del
 * seminario y las instituciones que colaboran, cuyos logos tienen texto que impreso pequeño
 * no se lee. Daniel eligió la versión reutilizable. Ese mismo día salió la foto de Mauricio,
 * y luego su nombre: él pidió en su lugar el logo de su laboratorio (`Laboratorio`).
 *
 * Queda, de arriba abajo: la marca; la tesis del seminario y su frase técnica; el QR al
 * sitio, a la altura de los ojos (entre 60 y 90 cm bajo el borde superior); el laboratorio
 * que organiza; y las instituciones, en grande (`POR_LAMINA`: `escalaParticipantes`).
 *
 * Mismos componentes y escala tipográfica que el carrusel: 1 px son 0,741 mm impresos
 * (`src/data/flyer.ts`). Las marcas van con su archivo original (RF-33.4).
 */
import type { Contenido } from '~/data/contenido';
import Laboratorio from './Laboratorio.astro';
import MarcaSeminario from './MarcaSeminario.astro';
import Qr from './Qr.astro';
import { datosFlyer } from './datos';

interface Props {
  c: Contenido;
}

const { c } = Astro.props;
const t = c.ui.flyer;
const { dominio, tesis, urlSitio } = datosFlyer(c);
---

<MarcaSeminario c={c} anchoLogo={900} />

<div class="flex flex-1 flex-col justify-evenly">
  <section class="mt-[40px]">
    <p class="font-display text-[60px] leading-[1.08] font-semibold text-balance text-foreground">{tesis}</p>
    <p class="mt-[18px] text-[34px] leading-[1.35] text-pretty text-muted-foreground">{t.gancho}</p>
  </section>

  <section class="mt-[40px] flex items-center gap-[48px]">
    <Qr url={urlSitio} tamano={300} />
    <div class="min-w-0">
      <p class="text-[36px] leading-[1.25] text-foreground">{t.escanea}</p>
      <p class="mt-[8px] text-[64px] leading-none font-semibold text-accent">{dominio}</p>
    </div>
  </section>

  <div class="mt-[40px] border-t hairline pt-[32px]">
    <Laboratorio c={c} />
  </div>

  {/* Rótulo de la fila de instituciones, que `CartelFlyer` pone justo debajo, en grande. */}
  <p class="eyebrow mt-[40px] text-[31px]">{c.ui.organizacion.participantes}</p>
</div>
