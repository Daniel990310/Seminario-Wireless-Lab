---
/**
 * Cabecera de las láminas interiores: logo horizontal, fecha y dominio. Una lámina del
 * carrusel se comparte suelta —una captura, un reenvío—, y sin esto no diría de qué evento
 * es ni dónde inscribirse (RF-25.2).
 *
 * Logo horizontal a 430 px, sobre su mínimo de 420 (RF-26.1).
 */
import type { Contenido } from '~/data/contenido';
import LogoHorizontal from './LogoHorizontal.astro';
import { datosFlyer } from './datos';

interface Props {
  c: Contenido;
}

const { c } = Astro.props;
const { dominio } = datosFlyer(c);
---

<div class="flex items-center justify-between">
  <LogoHorizontal ancho={430} />
  <div class="text-right">
    <p class="font-mono text-[36px] leading-tight font-semibold text-accent">{c.dates.shortLabel}</p>
    <p class="text-[31px] leading-tight text-muted-foreground">{dominio}</p>
  </div>
</div>
