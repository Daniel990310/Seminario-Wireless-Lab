---
/**
 * Pantalla de acceso de la Sede PUCV Santiago, 1920 × 1080 (RF-34.1): lo primero que ve
 * quien llega. Marca, fecha, sede y organizador, como la portada del carrusel, y un QR al
 * programa del sitio: el día del evento lo que se busca es la hora de cada charla, no el
 * formulario de inscripción.
 *
 * Se ve a 3–8 m en una pantalla de 1,5–2 m de ancho, así que la escala es la de la
 * portada: el piso de 31 px queda en unos 3 cm `[supuesto: tamaño de la pantalla sin
 * confirmar con la sede]`.
 */
import type { Contenido } from '~/data/contenido';
import Encabezado from './Encabezado.astro';
import Qr from './Qr.astro';
import { datosFlyer } from './datos';

interface Props {
  c: Contenido;
}

const { c } = Astro.props;
const { dominio, urlPrograma } = datosFlyer(c);
---

<div class="flex flex-1 items-center justify-between gap-[72px]">
  <div class="min-w-0">
    <Encabezado c={c} anchoLogo={640} />
  </div>
  <div class="shrink-0 text-right">
    <Qr url={urlPrograma} tamano={340} rotulo={c.ui.flyer.programaQr} lado="derecha" />
    <p class="mt-[8px] text-[40px] leading-none font-semibold text-foreground">{dominio}</p>
  </div>
</div>

