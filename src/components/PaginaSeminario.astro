---
/**
 * La página completa del seminario, parametrizada por idioma (T7).
 *
 * Existe para que `/` y `/en/` **no** sean dos copias del mismo marcado. Las
 * rutas de `src/pages/` solo eligen el idioma; toda la estructura vive aquí, así
 * que un cambio de composición no puede aplicarse a un idioma y olvidarse en el
 * otro.
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import SiteHeader from '~/components/SiteHeader.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import SpeakerCard from '~/components/SpeakerCard.astro';
import ProgramPending from '~/components/ProgramPending.astro';
import ProgramaJornadas from '~/components/ProgramaJornadas.astro';
import LogoWall from '~/components/LogoWall.astro';
import VenueLocator from '~/components/VenueLocator.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import FranjaSede from '~/components/FranjaSede.astro';
import { contenido, type Idioma } from '~/data/contenido';

/*
 * Recorte de la fotografía de la sede (RF-21): el nivel de calle —árboles, sello,
 * columnas, entrada—, que es la parte reconocible y la que tiene gente. Se cortó
 * ya apaisado, a la proporción de la banda, en lugar de recortar por CSS el
 * original vertical de 2000×2125: así el navegador no descarga los píxeles que la
 * franja nunca muestra. Ahorro medido: de 126 kB a 55 kB en la variante de 1440.
 */
import sedeAcceso from '~/assets/fondos/sede-acceso.webp';

interface Props {
  lang: Idioma;
}

const c = contenido(Astro.props.lang);
const { program, speakers, topics, venue, organizers, participants, funding, about, ui } = c;
const hasProgram = program.days.length > 0;
---

<BaseLayout c={c}>
  <SiteHeader c={c} />

  <main>
    <!--
      Franja de la sede: encabeza el hero.

      Va **antes** del hero y no dentro, por decisión de Daniel del 2026-08-09.
      Dentro tendría que compartir sitio con la figura del radar y con el titular,
      y ese es el reparto que descartó el mismo día («va a quedar demasiado
      cargada»). Como hermana de `main` sangra a los dos bordes sin márgenes
      negativos, porque el ancho máximo lo imponen las secciones, no `main`.

      Hubo una segunda franja cerrando «El seminario», al 50 %, para cumplir la
      proporción 90/50 que Daniel había pedido. Se retiró el mismo día: con la
      franja ya en cabecera, la de abajo repetía el recurso a dos pantallas de
      distancia sin añadir nada.
    -->
    <FranjaSede imagen={sedeAcceso} encuadre="50% 50%" />

    <Hero c={c} />

    <!-- El seminario -->
    <Section
      id="seminario"
      eyebrow={ui.secciones.seminario.eyebrow}
      title={ui.secciones.seminario.title}
      lead={about.lead}
    >
      <div class="mt-14 grid gap-14 lg:grid-cols-[1.1fr_1fr] lg:gap-20">
        <div class="reveal min-w-0 space-y-6 text-base leading-relaxed text-muted-foreground sm:text-lg">
          {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <!-- Temas del seminario -->
        <ul class="grid gap-px overflow-hidden rounded-surface border border-border sm:grid-cols-2">
          {
            topics.map((topic, index) => (
              <li
                class="reveal min-w-0 bg-surface/60 p-5"
                style={`transition-delay:${index * 80}ms`}
              >
                <h3 class="font-display text-base font-semibold text-foreground">{topic.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{topic.description}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </Section>

    <!--
      Programa.

      Sin `lead`. Era `${c.dates.label} · ${venue.name}` y producía la tercera repetición
      de la misma sección: el epígrafe decía «Programa», el título dice las fechas, y
      este subtítulo las repetía y encima añadía la sede, que tiene su propia sección y
      ya aparece en el hero. Retirado el epígrafe, el título ya declara las fechas y el
      subtítulo no tenía nada que añadir. `[2026-08-06]`
    -->
    <Section
      id="programa"
      title={ui.secciones.programa.title}
      tinted
    >
      <div class="mt-12">
        {
          hasProgram ? (
            <div class="space-y-10">
              {/*
                Aviso obligatorio si las sesiones son de ejemplo. Va arriba del
                todo, con `role="note"` para que un lector de pantalla lo anuncie
                antes que el programa, no después.
              */}
              {program.esDemostracion && (
                <p
                  role="note"
                  class="reveal border-l-2 border-accent bg-accent/8 px-5 py-4 text-sm leading-relaxed text-foreground"
                >
                  <strong class="font-semibold">{ui.programa.avisoDemostracion}</strong>
                </p>
              )}
              <ProgramaJornadas c={c} />
            </div>
          ) : (
            /* Estado provisional: se reemplaza solo al poblar program.days */
            <div class="reveal">
              <ProgramPending c={c} />
            </div>
          )
        }
      </div>
    </Section>

    <!-- Expositores -->
    <Section
      id="expositores"
      title={ui.secciones.expositores.title}
      lead={ui.secciones.expositores.lead}
    >
      <div class="mt-14 space-y-20">
        <div>
          <h3 class="reveal eyebrow flex items-center gap-4 text-muted-foreground">
            <span>{ui.expositores.internacionales}</span>
            <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
          </h3>
          <div class="mt-10 grid gap-x-10 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
            {
              speakers.international.map((speaker, index) => (
                <SpeakerCard speaker={speaker} index={index} ui={ui} />
              ))
            }
          </div>
        </div>

        <div>
          <h3 class="reveal eyebrow flex items-center gap-4 text-muted-foreground">
            <span>{ui.expositores.nacionales}</span>
            <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
          </h3>
          <div class="mt-10 grid gap-x-10 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
            {
              speakers.national.map((speaker, index) => (
                <SpeakerCard speaker={speaker} index={index} ui={ui} />
              ))
            }
          </div>
        </div>
      </div>
    </Section>

    <!-- Red de colaboración: topología del seminario -->
    <!--
      Aquí vivía la sección «Instituciones vinculadas» —el diagrama de red de T3— y se
      retiró el 2026-08-07 por decisión de Daniel.

      El motivo es de información, no de forma: el diagrama mostraba cada institución con su
      expositor y su país, y **las tres cosas ya están en «Expositores»**; y marcaba a la PUCV
      como organizadora, que **ya está en «Organización»**. No aportaba un dato que no
      estuviera dos veces más abajo. Un diagrama que solo reordena lo que ya se dijo pesa
      —era la sección más compleja del sitio— y no informa.

      Lo que se retiró con ella: `CollaborationNetwork.astro`, la entrada «Red» de la
      navegación en los dos idiomas, y `scripts/verify-red.mjs`, que verificaba T3 y quedó sin
      objeto. El detalle está en `specs/002-rediseno-visual/requirements.md`, RF-16.
    -->

    <!-- Sede -->
    <Section id="sede" title={ui.secciones.sede.title}>
      <!-- `items-start`, no `items-center`: centrar dejaba un vacío grande sobre la dirección. -->
      <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:items-start lg:gap-16">
        <!--
          `min-w-0`: los items de una retícula traen `min-width: auto`, así que el
          contenido más largo —aquí el correo, con el texto al 200 %— impone un
          ancho mínimo y la columna empuja la página hacia la derecha antes de que
          `overflow-wrap` llegue a partir nada. Con `min-w-0` la columna encoge y
          el texto parte (WCAG 1.4.4, T6).
        -->
        <div class="reveal min-w-0">
          <address class="space-y-1 text-base not-italic sm:text-lg">
            <p class="font-display text-lg font-semibold text-foreground">{venue.name}</p>
            <p class="text-muted-foreground">{venue.street}</p>
            <p class="text-muted-foreground">{venue.district}, {venue.city}</p>
            <p class="text-muted-foreground">{venue.country}</p>
          </address>

          <!-- Los enlaces a mapas viven en el panel localizador, a la derecha. -->
          <!-- `[&>div]:min-w-0` por lo mismo que la columna: el correo no partía. -->
          <dl class="mt-10 grid gap-6 border-t hairline pt-8 [&>div]:min-w-0 sm:grid-cols-2">
            <div>
              <dt class="eyebrow text-muted-foreground">{ui.sede.fechas}</dt>
              <dd class="mt-2 text-base text-foreground">{c.dates.label}</dd>
            </div>
            <div>
              <dt class="eyebrow text-muted-foreground">{ui.sede.consultas}</dt>
              <dd class="mt-2 text-base">
                <a
                  href={`mailto:${c.contact.email}`}
                  class="text-primary underline decoration-primary/40 underline-offset-4 transition-colors hover:decoration-primary"
                >
                  {c.contact.email}
                </a>
              </dd>
            </div>
          </dl>
        </div>

        <div class="reveal min-w-0">
          <VenueLocator c={c} />
        </div>
      </div>
    </Section>

    <!-- Organización, instituciones y financiamiento -->
    <Section
      id="organizacion"
      title={ui.secciones.organizacion.title}
    >
      <div class="mt-14 space-y-16">
        <div>
          <h3 class="reveal eyebrow flex items-center gap-4 text-muted-foreground">
            <span>{ui.organizacion.organizan}</span>
            <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
          </h3>
          <!--
            Sin lista de nombres bajo los logos, retirada el 2026-08-07.

            Existía mientras los logos eran marcadores de posición que solo decían «LOGO
            PENDIENTE»: entonces el nombre tenía que estar escrito. Con las marcas oficiales
            instaladas, el nombre **ya está dentro de la marca**, así que la lista lo repetía
            en pequeño. Y peor: se disponía en columnas cuyo orden no coincidía con el de los
            logos, así que el nombre no quedaba ni debajo de su propio logo.

            No se pierde para una ayuda técnica: cada logo lleva `alt={institution.name}`.
          -->
          <div class="mt-8">
            <LogoWall institutions={organizers} size="lg" />
          </div>
        </div>

        <div>
          <h3 class="reveal eyebrow flex items-center gap-4 text-muted-foreground">
            <span>{ui.organizacion.participantes}</span>
            <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
          </h3>
          <!-- Sin lista de nombres, por lo mismo que arriba. -->
          <div class="mt-8">
            <LogoWall institutions={participants} />
          </div>
        </div>

        <!-- Financiamiento: obligatorio dar crédito a ANID y al proyecto FOVI -->
        <div class="reveal surface rounded-surface p-7 sm:p-10">
          <h3 class="eyebrow text-muted-foreground">{ui.organizacion.financia}</h3>
          <div class="mt-7 grid gap-8 sm:grid-cols-[auto_1fr] sm:items-center sm:gap-10">
            <a
              href={funding.agency.url}
              target="_blank"
              rel="noopener noreferrer"
              class="block opacity-80 transition-opacity hover:opacity-100"
              title={funding.agency.name}
            >
              {/* Una variante por fondo, como en `LogoWall` y por lo mismo (RF-10). */}
              <img
                src={funding.agency.logo}
                alt={funding.agency.name}
                class:list={[
                  'h-16 w-auto object-contain sm:h-20',
                  funding.agency.logoOscuro && 'dark:hidden',
                ]}
                loading="lazy"
                decoding="async"
              />
              {funding.agency.logoOscuro && (
                <img
                  src={funding.agency.logoOscuro}
                  alt={funding.agency.name}
                  class="hidden h-16 w-auto object-contain sm:h-20 dark:block"
                  loading="lazy"
                  decoding="async"
                />
              )}
            </a>
            <div class="min-w-0">
              {/*
                Esta frase es la nomenclatura que ANID exige, no una redacción
                nuestra (RNF-8.1), y por eso llega armada desde `contenido.ts` y no
                se traduce: la fórmula es institucional y en español.
              */}
              <p class="font-display text-base font-semibold text-foreground">
                {funding.mencion}
              </p>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                {/*
                  El espacio va explícito: Astro descarta el texto que solo tiene
                  espacios entre una expresión y una etiqueta, y salía
                  «ProyectoFOVI250222» pegado. Se vio en la captura, no en el código.
                */}
                {ui.organizacion.proyecto}{' '}
                <span class="font-mono text-primary">{funding.project.code}</span>,
                <span class="italic"> {funding.project.name}</span>.
              </p>
            </div>
          </div>
        </div>
      </div>
    </Section>
  </main>

  <SiteFooter c={c} />
</BaseLayout>
