---
import PropagationFigure from './PropagationFigure.astro';
import { seminar } from '~/data/seminar';
---

<section id="top" class="relative isolate overflow-hidden pt-28 pb-16 sm:pt-32 sm:pb-24">
  <!-- Figura de fondo: dominante en escritorio, atenuada en móvil -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute inset-0 grid-backdrop opacity-60"></div>
    <div
      class="absolute top-0 right-0 h-full w-full opacity-45 sm:w-[72%] sm:opacity-100 lg:w-[62%]"
    >
      <PropagationFigure />
    </div>
    <!-- Degradados que garantizan contraste del texto sobre la figura -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-background via-background/90 to-background/25 sm:via-background/55 sm:to-transparent"
    >
    </div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-background to-transparent"></div>
  </div>

  <div id="contenido" class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="max-w-3xl">
      <p class="eyebrow flex flex-wrap items-center gap-x-3 gap-y-2">
        <span>Seminario internacional</span>
        <span class="h-px w-8 bg-primary/40" aria-hidden="true"></span>
        <span class="text-muted-foreground">PUCV · Chile · 2026</span>
      </p>

      <!--
        Título sin degradados ni animación de texto: el registro es
        institucional, y la jerarquía se resuelve con peso y color sólido.
      -->
      <h1 class="mt-7 text-hero leading-[1.04] font-semibold text-foreground">
        Beyond Connectivity: Wireless Sensing in mmWave and Sub-THz Bands
      </h1>

      <span class="mt-7 block h-px w-24 bg-primary/80" aria-hidden="true"></span>

      <p class="mt-7 max-w-2xl font-display text-base leading-snug text-muted-foreground sm:text-xl">
        {seminar.subtitle}
      </p>

      <!-- Datos clave: fecha y lugar, la información que más se busca -->
      <dl class="mt-10 grid gap-px overflow-hidden rounded-surface border border-border sm:grid-cols-2">
        <div class="bg-surface/70 p-5 backdrop-blur-sm">
          <dt class="eyebrow text-muted-foreground">Fechas</dt>
          <dd class="mt-2 font-display text-lg font-semibold text-foreground">
            {seminar.dates.label}
          </dd>
        </div>
        <div class="bg-surface/70 p-5 backdrop-blur-sm">
          <dt class="eyebrow text-muted-foreground">Lugar</dt>
          <dd class="mt-2 font-display text-lg font-semibold text-foreground">
            {seminar.venue.name}
          </dd>
          <dd class="mt-1 text-sm text-muted-foreground">{seminar.venue.fullAddress}</dd>
        </div>
      </dl>

      <div class="mt-9 flex flex-wrap items-center gap-4">
        <!--
          Botones rectos y de acento apagado. El cian saturado del relleno
          resultaba estridente para el registro institucional del seminario.
        -->
        <a
          href="#programa"
          class="rounded-control bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition-opacity duration-200 hover:opacity-90"
        >
          Ver programa
        </a>
        <a
          href="#expositores"
          class="rounded-control border border-border-control px-6 py-3 text-sm font-medium text-foreground transition-colors hover:border-primary/50 hover:text-primary"
        >
          Expositores
        </a>
      </div>
    </div>
  </div>
</section>
