---
/**
 * Localizador de la sede.
 *
 * Por defecto muestra un panel propio con la dirección, sin ninguna petición a
 * terceros. El mapa de OpenStreetMap se inserta solo si la persona lo pide.
 *
 * Se optó por carga bajo demanda en lugar de un iframe permanente por dos
 * razones: no se envía la visita a un tercero sin consentimiento, y si una red
 * institucional bloquea el embed el bloque no queda como un recuadro roto.
 */
import type { Contenido } from '~/data/contenido';

interface Props {
  c: Contenido;
}

const { c } = Astro.props;
const { venue, ui } = c;

// Coordenadas aproximadas de Antonio Bellet 314, Providencia.
const LAT = -33.421;
const LON = -70.61;
const BBOX = [LON - 0.0055, LAT - 0.0035, LON + 0.0055, LAT + 0.0035].join('%2C');
const EMBED = `https://www.openstreetmap.org/export/embed.html?bbox=${BBOX}&layer=mapnik&marker=${LAT}%2C${LON}`;
---

<div
  class="surface rounded-surface"
  data-venue-locator
  data-embed={EMBED}
  data-embed-title={ui.sede.tituloMapa}
>
  <!--
    Altura mínima, no fija: con `h-` el bloque de texto desbordaba el panel en
    los anchos estrechos, donde los dos botones se apilan.
  -->
  <div class="flex min-h-[320px] flex-col sm:min-h-[420px]" data-locator-panel>
    <!--
      Banda del marcador (T5): la retícula técnica vive aquí, en una zona **sin
      texto encima**. Antes envolvía al contenido completo y dejaba la
      dirección, los botones y la nota con el contraste indeterminado.

      Los anillos de cobertura de `Ripple` se retiraron: sus círculos son
      elementos con `background-color` de hasta 470 px, y sus rects desbordaban
      esta banda por mucho que `overflow-hidden` recorte el dibujo, con lo que
      axe seguía sin poder determinar el fondo del texto vecino. Usaban además
      `shadow-xl`, que el sistema no admite.
    -->
    <div
      class="relative flex flex-1 items-center justify-center overflow-hidden border-b border-border"
      aria-hidden="true"
    >
      <div class="absolute inset-0 grid-backdrop opacity-45"></div>

      <!-- `currentColor` para que el marcador siga al tema sin duplicar el SVG. -->
      <svg class="relative size-12 text-primary sm:size-14" viewBox="0 0 48 48" fill="none">
        <g stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M24 42c0 0 13-12.2 13-21.7A13 13 0 1 0 11 20.3C11 29.8 24 42 24 42Z" />
        </g>
        <circle cx="24" cy="20" r="4.5" fill="currentColor" />
      </svg>
    </div>

    <!-- Campo de texto: fondo plano y opaco, sin nada por delante ni por debajo. -->
    <div class="bg-surface px-6 py-6 text-center">
      <!-- La dirección postal no se traduce; el país sí. Ver `src/data/comun.ts`. -->
      <p class="font-display text-lg font-semibold text-foreground">
        {venue.street}, {venue.district}
      </p>
      <p class="mt-2 text-sm text-muted-foreground">{venue.city}, {venue.country}</p>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <!--
          Borde a plena intensidad, no `/40`, por la misma razón que el botón de contacto de
          la barra: al 40 % medía **2,66:1 en tema claro y 1,09:1 en oscuro** contra su propio
          fondo `[medido: 2026-08-06]`, por debajo del 3:1 que WCAG 1.4.11 pide al límite de
          un control. Este es el botón que carga el mapa, así que parecer texto suelto es
          peor aquí que en cualquier otro sitio: es la acción principal de la sección.
        -->
        <button
          type="button"
          data-locator-load
          class="rounded-control border border-primary bg-primary/8 px-5 py-2 text-sm font-medium text-primary transition-colors hover:bg-primary/15"
        >
          {ui.sede.cargarMapa}
        </button>
        <a
          href={venue.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-control border border-border-control px-5 py-2 text-sm font-medium text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary"
        >
          {ui.sede.abrirEnGoogleMaps}
        </a>
      </div>

      <p class="mx-auto mt-6 max-w-xs text-xs leading-relaxed text-muted-foreground">
        {ui.sede.avisoMapa}
      </p>
    </div>
  </div>
</div>

<script>
  /*
   * El mapa se inserta AL ENTRAR LA SECCIÓN EN PANTALLA, y también al pulsar el botón.
   *
   * Daniel pidió el 2026-08-09 que el mapa se vea siempre, no tras un clic. Hacerlo cargando
   * el iframe con la página **rompería RNF-2.3**, que exige que no haya ninguna petición a
   * dominios de terceros en la carga inicial —y RNF-2.2 lo da por hecho: fija el presupuesto
   * «sin contar el mapa que se carga a petición»—. Además enviaría la visita a Google, con sus
   * cookies, antes de que nadie llegue siquiera a la sección de la sede.
   *
   * Cargarlo al hacerse visible da lo que se pidió sin romper nada: quien llega a la sede ve
   * el mapa ya puesto, y quien nunca baja hasta ahí no le manda nada a Google. En la carga
   * inicial no se pide un solo byte a terceros, que es literalmente lo que dice el requisito.
   *
   * El botón se conserva como camino alternativo: si `IntersectionObserver` no existe o el
   * observador no llega a disparar, el bloque sigue siendo utilizable en lugar de quedarse en
   * un panel muerto.
   */
  for (const locator of document.querySelectorAll<HTMLElement>('[data-venue-locator]')) {
    const button = locator.querySelector<HTMLButtonElement>('[data-locator-load]');
    const panel = locator.querySelector<HTMLElement>('[data-locator-panel]');
    const { embed, embedTitle } = locator.dataset;

    if (!button || !panel || !embed) continue;

    let insertado = false;
    const insertar = () => {
      if (insertado) return;
      insertado = true;
      const iframe = document.createElement('iframe');
      iframe.src = embed;
      iframe.title = embedTitle ?? 'Mapa de la sede';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.className = 'relative block h-[320px] w-full border-0 sm:h-[420px]';
      panel.replaceWith(iframe);
    };

    button.addEventListener('click', insertar, { once: true });

    /*
     * `rootMargin` de 200 px: empieza a cargar un poco antes de que el bloque asome, para que
     * al llegar el mapa ya esté, y no se vea el panel cambiando por el iframe delante de la
     * cara. Sigue sin pedir nada mientras la sección esté lejos.
     */
    if ('IntersectionObserver' in window) {
      const observador = new IntersectionObserver(
        (entradas) => {
          if (!entradas.some((e) => e.isIntersecting)) return;
          observador.disconnect();
          insertar();
        },
        { rootMargin: '200px' },
      );
      observador.observe(locator);
    }
  }
</script>
