---
/**
 * Localizador de la sede.
 *
 * Por defecto muestra un panel propio con la dirección, sin ninguna petición a
 * terceros. El mapa de OpenStreetMap se inserta solo si la persona lo pide.
 *
 * Se optó por carga bajo demanda en lugar de un iframe permanente por dos
 * razones: no se envía la visita a un tercero sin consentimiento, y si una red
 * institucional bloquea el embed el bloque no queda como un recuadro roto.
 */
import { Ripple } from '~/components/ui/ripple';
import { seminar } from '~/data/seminar';

const { venue } = seminar;

// Coordenadas aproximadas de Antonio Bellet 314, Providencia.
const LAT = -33.421;
const LON = -70.61;
const BBOX = [LON - 0.0055, LAT - 0.0035, LON + 0.0055, LAT + 0.0035].join('%2C');
const EMBED = `https://www.openstreetmap.org/export/embed.html?bbox=${BBOX}&layer=mapnik&marker=${LAT}%2C${LON}`;
---

<div
  class="surface relative overflow-hidden rounded-surface"
  data-venue-locator
  data-embed={EMBED}
  data-embed-title={`Mapa de ${venue.name}`}
>
  <div class="absolute inset-0 grid-backdrop opacity-45" aria-hidden="true"></div>

  <div
    class="relative flex h-[320px] flex-col items-center justify-center px-6 text-center sm:h-[420px]"
    data-locator-panel
  >
    <!--
      Ripple de Magic UI: anillos concéntricos que laten alrededor del marcador,
      como una zona de cobertura. Solo CSS, sin JavaScript en el cliente.
    -->
    <Ripple
      mainCircleSize={120}
      mainCircleOpacity={0.16}
      numCircles={6}
      className="text-primary/30"
    />

    <!-- `currentColor` para que el marcador siga al tema sin duplicar el SVG. -->
    <svg
      class="relative size-12 text-primary sm:size-14"
      viewBox="0 0 48 48"
      fill="none"
      aria-hidden="true"
    >
      <g stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M24 42c0 0 13-12.2 13-21.7A13 13 0 1 0 11 20.3C11 29.8 24 42 24 42Z" />
      </g>
      <circle cx="24" cy="20" r="4.5" fill="currentColor" />
    </svg>

    <p class="relative mt-5 font-display text-lg font-semibold text-foreground">
      {venue.street}, {venue.district}
    </p>
    <p class="relative mt-1 text-sm text-muted-foreground">{venue.city}, {venue.country}</p>

    <div class="relative mt-7 flex flex-wrap items-center justify-center gap-3">
      <button
        type="button"
        data-locator-load
        class="rounded-control border border-primary/40 bg-primary/8 px-5 py-2.5 text-sm font-medium text-primary transition-colors hover:bg-primary/15"
      >
        Cargar mapa interactivo
      </button>
      <a
        href={venue.mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-control border border-border-control px-5 py-2.5 text-sm font-medium text-muted-foreground transition-colors hover:border-primary/50 hover:text-primary"
      >
        Abrir en Google Maps
      </a>
    </div>

    <p class="relative mt-5 max-w-xs text-xs leading-relaxed text-muted-foreground">
      Al cargar el mapa se solicita contenido a OpenStreetMap.
    </p>
  </div>
</div>

<script>
  // Inserta el iframe solo al pulsar el botón, y solo una vez.
  for (const locator of document.querySelectorAll<HTMLElement>('[data-venue-locator]')) {
    const button = locator.querySelector<HTMLButtonElement>('[data-locator-load]');
    const panel = locator.querySelector<HTMLElement>('[data-locator-panel]');
    const { embed, embedTitle } = locator.dataset;

    if (!button || !panel || !embed) continue;

    button.addEventListener(
      'click',
      () => {
        const iframe = document.createElement('iframe');
        iframe.src = embed;
        iframe.title = embedTitle ?? 'Mapa de la sede';
        iframe.loading = 'lazy';
        iframe.referrerPolicy = 'no-referrer-when-downgrade';
        iframe.className = 'relative block h-[320px] w-full border-0 sm:h-[420px]';
        panel.replaceWith(iframe);
      },
      { once: true },
    );
  }
</script>
