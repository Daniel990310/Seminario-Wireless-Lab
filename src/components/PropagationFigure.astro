---
/**
 * Gráfica principal del seminario.
 *
 * Figura vectorial propia que representa detección inalámbrica en mmWave y
 * sub-THz: un emisor sobre una retícula polar de radar y frentes de onda que
 * se propagan. La malla térmica interactiva comparte este mismo centro. Es SVG
 * puro, por lo que escala sin pérdida, pesa unos
 * pocos kB y no depende de imágenes de stock.
 */

interface Props {
  class?: string;
  /** Nombre accesible de la figura. Llega traducido (RF-1.7). */
  titulo: string;
  descripcion: string;
}

const { class: className = '', titulo, descripcion } = Astro.props;

/*
 * Encaje: `xMinYMid slice`.
 *
 * Antes era `xMidYMid meet`, y la nota decía que `slice` cortaba el resplandor del
 * emisor y dejaba una costura vertical. Era cierto **con `xMid`**: al centrar, el
 * recorte se reparte entre los dos lados y se come el emisor, que está al 18 % del
 * ancho. Con `xMin` el borde izquierdo queda anclado, el emisor y su resplandor
 * —centro en x=148, radio 96, o sea x=52…244— quedan enteros, y el recorte cae
 * entero del lado derecho, que es exactamente hacia donde se quiere sangrar.
 *
 * `meet` era además la causa del aire sobrante: en una celda alta y estrecha
 * escalaba por el lado corto y dejaba franjas vacías arriba y abajo.
 *
 * OJO: `SensingPersistence` replica esta transformación para alinear la malla con la
 * retícula. Si esto cambia, hay que cambiar `dimensionar()` allí.
 */
const SOURCE = { x: 148, y: 322 };

/*
 * ═══ UNA SOLA RETÍCULA RADIAL PARA TODA LA FIGURA ═══
 *
 * Antes había **tres series distintas y ninguna coincidía con otra**: los frentes de onda en
 * 78 + k·62, los anillos de rango en 72 + k·62 —desfasados 6 unidades, que no es una decisión
 * sino un descuido— y la malla interactiva en 30 + k·22,5, que no caía sobre ninguna. El
 * resultado se veía como un origen desplazado y unos arcos que no casaban con nada.
 *
 * Ahora las tres derivan de estas dos constantes. Los anillos y los frentes comparten
 * exactamente los mismos radios, y la malla usa un tercio del paso, de modo que **uno de cada
 * tres nodos cae sobre un arco**. Es lo que hace que las dos capas se lean como el mismo
 * instrumento y no como dos dibujos superpuestos.
 *
 * OJO: `SensingPersistence` replica esta serie. Si `PASO_RADIAL` o `RADIO_PRIMERO` cambian
 * aquí, hay que cambiar allí `RADIO_MINIMO` y `RADIO_MAXIMO`, que están calculados desde
 * estos mismos números.
 */
const RADIO_PRIMERO = 78;
const PASO_RADIAL = 62;

// Frentes de onda: arcos concéntricos que se atenúan con la distancia,
// siguiendo la caída de potencia con el rango.
const wavefronts = Array.from({ length: 9 }, (_, i) => {
  const radius = RADIO_PRIMERO + i * PASO_RADIAL;
  return {
    radius,
    opacity: +(0.66 - i * 0.055).toFixed(3),
    width: +(1.8 - i * 0.13).toFixed(2),
  };
});

// Retícula polar de referencia. Los anillos se dividen en tramos para que la
// apertura pierda opacidad de forma gradual: una máscara rectangular volvería
// a introducir el borde artificial que se descartó en RF-9.12.
const APERTURA = 78;
const ANGULOS_RETICULA = 19;
// Los anillos comparten los radios de los frentes de onda, no una serie propia desfasada 6
// unidades como antes: así el anillo de referencia y el frente que lo cruza son el mismo radio.
const rangeRings = Array.from({ length: 8 }, (_, k) => RADIO_PRIMERO + k * PASO_RADIAL);
const angulos = Array.from(
  { length: ANGULOS_RETICULA },
  (_, i) => -APERTURA + i * ((APERTURA * 2) / (ANGULOS_RETICULA - 1)),
);
const polar = (radio: number, grados: number) => ({
  x: SOURCE.x + Math.cos((grados * Math.PI) / 180) * radio,
  y: SOURCE.y + Math.sin((grados * Math.PI) / 180) * radio,
});
const mascaraAngular = (u: number) => Math.pow(Math.sin(Math.PI * u), 1.45);
const tramosRango = rangeRings.flatMap((radio, indiceRadio) =>
  angulos.slice(0, -1).map((inicio, indiceAngulo) => {
    const fin = angulos[indiceAngulo + 1]!;
    const a = polar(radio, inicio);
    const b = polar(radio, fin);
    const u = (indiceAngulo + 0.5) / (ANGULOS_RETICULA - 1);
    const exterior = Math.pow(Math.cos((Math.PI * 0.5 * indiceRadio) / rangeRings.length), 1.35);
    return {
      d: `M ${a.x} ${a.y} A ${radio} ${radio} 0 0 1 ${b.x} ${b.y}`,
      opacity: +(mascaraAngular(u) * exterior * 0.34).toFixed(3),
    };
  }),
);
/*
 * Estela del barrido, como sector angular y no como rectángulo.
 *
 * Un `rect` de altura constante girando alrededor del emisor **no** se lee como un
 * barrido: se lee como una varilla apoyada encima, y en claro además salía beige
 * `[capturas, 2026-08-06]`. Un barrido real es un sector cuyo ancho crece con el
 * radio. Se construye como una escalera de sectores finos con opacidad decreciente:
 * el borde de ataque es el más intenso y la cola llega a cero. No hace falta ningún
 * gradiente angular, que SVG no tiene sin recurrir a máscaras.
 */
// El radio se queda **por dentro** del anillo exterior de la retícula (506): con 548
// el sector sobresalía del instrumento y quedaba flotando sobre fondo vacío.
const RADIO_BARRIDO = 498;
const ESTELA_GRADOS = 34;
const ESTELA_TRAMOS = 17;
const estela = Array.from({ length: ESTELA_TRAMOS }, (_, i) => {
  const desde = -(i + 1) * (ESTELA_GRADOS / ESTELA_TRAMOS);
  const hasta = -i * (ESTELA_GRADOS / ESTELA_TRAMOS);
  const a = polar(RADIO_BARRIDO, desde);
  const b = polar(RADIO_BARRIDO, hasta);
  // Caída cuadrática: la cola se apaga rápido, como la persistencia de un tubo.
  const caida = Math.pow(1 - i / ESTELA_TRAMOS, 2);
  return {
    d: `M ${SOURCE.x} ${SOURCE.y} L ${a.x} ${a.y} A ${RADIO_BARRIDO} ${RADIO_BARRIDO} 0 0 1 ${b.x} ${b.y} Z`,
    // El barrido es el elemento menos significativo de la figura: no puede ser el más
    // visible. A 0,13 se leía como un triángulo beige macizo sobre el fondo claro.
    opacity: +(caida * 0.06).toFixed(4),
  };
});

const radiales = angulos.map((angulo, i) => {
  // 560 y no 548: la fila más externa de la malla llega a 553,33 —78 + 23 × 62/3— y una radial
  // que se queda corta deja los últimos nodos flotando sin retícula debajo.
  const extremo = polar(560, angulo);
  return {
    x2: extremo.x,
    y2: extremo.y,
    opacity: +(mascaraAngular(i / (ANGULOS_RETICULA - 1)) * 0.26).toFixed(3),
  };
});

---

<!--
  Los `data-*` no son decoración: la capa de detección (`SensingPersistence`) lee
  de aquí el emisor y la apertura para construir la misma geometría polar.
-->
<svg
  class={`propagation-figure ${className}`}
  viewBox="0 0 820 640"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-labelledby="fig-title fig-desc"
  preserveAspectRatio="xMinYMid slice"
  data-figura
  data-emisor={`${SOURCE.x} ${SOURCE.y}`}
  data-apertura={APERTURA}
>
  <title id="fig-title">{titulo}</title>
  <desc id="fig-desc">{descripcion}</desc>

  <defs>
    <radialGradient id="fig-source-glow" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0%" stop-color="var(--primary)" stop-opacity="0.4" />
      <stop offset="45%" stop-color="var(--primary)" stop-opacity="0.12" />
      <stop offset="100%" stop-color="var(--primary)" stop-opacity="0" />
    </radialGradient>

    <!--
      El frente de onda **cambia de color con el rango**, y eso significa algo: el
      recurso sale como comunicación (`--primary`, el color de la red en toda la
      página) y vuelve como información sensada (`--accent`). Es la tesis de ISAC
      dicha en dos colores, sin añadir ni un trazo de geometría nueva —que es lo
      que D10 descartó cuando se retiraron el objeto reconstruido y sus rayos.
    -->
    <linearGradient id="fig-wave" x1="0" y1="0" x2="1" y2="0.4">
      <stop offset="0%" stop-color="var(--primary)" />
      <stop offset="62%" stop-color="var(--primary)" stop-opacity="0.8" />
      <stop offset="100%" stop-color="var(--accent)" stop-opacity="0.55" />
    </linearGradient>

    <filter id="fig-soft" x="-60%" y="-60%" width="220%" height="220%">
      <feGaussianBlur stdDeviation="7" />
    </filter>

    <!-- Recorta la figura al lienzo para que los arcos no desborden. -->
    <clipPath id="fig-clip">
      <rect width="820" height="640" />
    </clipPath>
  </defs>

  <g clip-path="url(#fig-clip)">
    <!--
      Anillos de rango segmentados: desaparecen hacia los cuatro bordes del sector.

      El trazo es `--primary`, no `--border`. `--border` es por definición el filete
      decorativo tenue —slate-300 en claro, 1,3:1 sobre el fondo— y con él la
      retícula polar quedaba invisible en tema claro `[medido: 2026-08-06, captura]`
      mientras se leía bien en oscuro: el mismo código daba dos calidades. La
      retícula de un instrumento de medida no es un filete de tarjeta. Las opacidades
      bajan de 0,9/0,7 a 0,34/0,26 para compensar los 10,99:1 de `--primary` y que el
      tema oscuro no se sature.
    -->
    <g stroke="var(--primary)" stroke-dasharray="2 7" stroke-linecap="round">
      {tramosRango.map((tramo) => <path d={tramo.d} stroke-opacity={tramo.opacity} />)}
    </g>

    <!-- Radiales del diagrama polar -->
    <g stroke="var(--primary)" stroke-linecap="round">
      {radiales.map((radial) => (
        <line
          x1={SOURCE.x}
          y1={SOURCE.y}
          x2={radial.x2}
          y2={radial.y2}
          stroke-opacity={radial.opacity}
        />
      ))}
    </g>

    <!-- Frentes de onda -->
    <g class="fig-waves" stroke="url(#fig-wave)" fill="none" stroke-linecap="round">
      {
        wavefronts.map((w, i) => (
          <path
            class="fig-wave"
            style={`--i:${i}`}
            stroke-opacity={w.opacity}
            stroke-width={w.width}
            d={`M ${SOURCE.x + Math.cos((-78 * Math.PI) / 180) * w.radius} ${
              SOURCE.y + Math.sin((-78 * Math.PI) / 180) * w.radius
            } A ${w.radius} ${w.radius} 0 0 1 ${
              SOURCE.x + Math.cos((78 * Math.PI) / 180) * w.radius
            } ${SOURCE.y + Math.sin((78 * Math.PI) / 180) * w.radius}`}
          />
        ))
      }
    </g>

    <!--
      Barrido de radar: dos bandas, no una.

      Una sola recta de 3 px congelada se leía como un trazo perdido cruzando el
      abanico en lugar de un barrido `[capturas, 2026-08-06]`. La banda ancha y muy
      tenue va detrás y hace de estela; la fina va delante y marca el frente. Van en
      `--accent` porque el barrido es el acto de **sensar**, no de transmitir.
    -->
    <g class="fig-sweep-group">
      {estela.map((tramo) => <path d={tramo.d} fill="var(--accent)" fill-opacity={tramo.opacity} />)}
      <!-- Borde de ataque: la única línea nítida del barrido. -->
      <line
        x1={SOURCE.x}
        y1={SOURCE.y}
        x2={polar(RADIO_BARRIDO, 0).x}
        y2={polar(RADIO_BARRIDO, 0).y}
        stroke="var(--accent)"
        stroke-opacity="0.42"
        stroke-width="1.2"
      />
    </g>

    <!-- Emisor -->
    <circle cx={SOURCE.x} cy={SOURCE.y} r="96" fill="url(#fig-source-glow)" filter="url(#fig-soft)" />
    <circle cx={SOURCE.x} cy={SOURCE.y} r="26" stroke="var(--primary)" stroke-opacity="0.3" stroke-width="1" />
    <circle cx={SOURCE.x} cy={SOURCE.y} r="13" stroke="var(--primary)" stroke-opacity="0.6" stroke-width="1.3" />
    <circle cx={SOURCE.x} cy={SOURCE.y} r="4.5" fill="var(--primary)" />
  </g>
</svg>

<style>
  .propagation-figure {
    width: 100%;
    height: 100%;
    display: block;

    /*
     * Sin esto aparece un globo flotante con el texto del `<title>` al dejar el puntero
     * sobre la figura, como el nombre de un archivo en el escritorio. Los navegadores
     * tratan el `<title>` de un SVG igual que el atributo `title` de HTML.
     *
     * No se puede quitar el `<title>`: es el que da el nombre accesible por
     * `aria-labelledby="fig-title fig-desc"`, y RF-9.3 exige que la figura siga descrita
     * sin JavaScript. `pointer-events: none` resuelve el conflicto sin tocar la
     * accesibilidad, porque el árbol de accesibilidad no depende del reparto de eventos:
     * el globo desaparece y el nombre accesible se conserva intacto.
     *
     * Tampoco rompe el efecto del puntero. Los escuchas de `pointermove` viven en el
     * contenedor, que es el PADRE de este SVG, así que al no ser blanco el SVG el blanco
     * pasa a ser el contenedor y el evento llega igual. Es la misma razón por la que el
     * lienzo de `SensingPersistence` ya era pasivo (RF-9.2).
     */
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Los frentes de onda laten hacia afuera de forma escalonada. */
    .fig-wave {
      transform-box: fill-box;
      transform-origin: 0% 50%;
      animation: fig-breathe 11s var(--ease-out-soft, ease-out) infinite;
      animation-delay: calc(var(--i) * -1.2s);
    }

    @keyframes fig-breathe {
      0%,
      100% {
        opacity: 0.35;
      }
      40% {
        opacity: 1;
      }
    }

    /* Barrido lento, con el ritmo de un instrumento y no de una interfaz. */
    .fig-sweep-group {
      transform-origin: 148px 322px;
      animation: fig-sweep 17s ease-in-out infinite;
    }

    /*
     * La opacidad va en el mismo ciclo que el giro, y no es adorno: la retícula se
     * desvanece hacia los bordes de la apertura por RF-9.12, así que en los extremos
     * del recorrido el sector quedaba flotando sobre fondo vacío. Se apaga donde no
     * hay instrumento debajo. Las dos propiedades se interpolan por separado, de modo
     * que declarar la opacidad al 25 % y al 75 % no altera el giro.
     *
     * Sin animación —`prefers-reduced-motion: reduce`— el grupo se queda en su estado
     * base: 0° y opacidad 1, o sea apuntando al centro del abanico, que es
     * exactamente donde tiene sentido que se detenga.
     */
    @keyframes fig-sweep {
      0% {
        transform: rotate(-74deg);
        opacity: 0;
      }
      25% {
        opacity: 1;
      }
      50% {
        transform: rotate(74deg);
        opacity: 0;
      }
      75% {
        opacity: 1;
      }
      100% {
        transform: rotate(-74deg);
        opacity: 0;
      }
    }

  }
</style>
