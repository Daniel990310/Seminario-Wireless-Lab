---
import { seminar } from '~/data/seminar';

const year = new Date().getFullYear();
---

<footer class="relative border-t hairline bg-surface/60 px-5 py-16 sm:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <p class="font-display text-lg leading-snug font-semibold text-foreground">
          {seminar.title}
        </p>
        <p class="mt-3 max-w-md text-sm leading-relaxed text-muted-foreground">{seminar.subtitle}</p>
        <p class="eyebrow mt-6 text-muted-foreground">{seminar.dates.shortLabel} · Santiago, Chile</p>
      </div>

      <div>
        <h2 class="eyebrow text-muted-foreground">Contacto</h2>
        <ul class="mt-4 space-y-3 text-sm text-muted-foreground">
          <li>
            <a
              href={`mailto:${seminar.contact.email}`}
              class="text-primary underline decoration-primary/40 underline-offset-4 transition-colors hover:decoration-primary"
            >
              {seminar.contact.email}
            </a>
          </li>
          <li class="leading-relaxed text-muted-foreground">{seminar.contact.school}</li>
        </ul>
      </div>

      <div>
        <h2 class="eyebrow text-muted-foreground">Secciones</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            [
              { href: '#seminario', label: 'El seminario' },
              { href: '#programa', label: 'Programa' },
              { href: '#expositores', label: 'Expositores' },
              { href: '#red', label: 'Red de colaboración' },
              { href: '#sede', label: 'Sede' },
              { href: '#organizacion', label: 'Organización' },
            ].map((link) => (
              <li>
                <a href={link.href} class="text-muted-foreground transition-colors hover:text-primary">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-4 border-t hairline pt-8 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        © {year} Pontificia Universidad Católica de Valparaíso · Escuela de Ingeniería Eléctrica
      </p>
      <p class="font-mono">
        Financiado por {seminar.funding.agency.shortName} · Proyecto {seminar.funding.project.code}
      </p>
    </div>
  </div>
</footer>
