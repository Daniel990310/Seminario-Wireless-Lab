---
/** Pie del sitio. Todo el texto llega por props: no hay cadenas aquí (RF-1.7). */
import type { Contenido } from '~/data/contenido';

interface Props {
  c: Contenido;
}

const { c } = Astro.props;
const year = new Date().getFullYear();
---

<!--
  El pie es una banda de azul institucional PUCV, por indicación de Daniel el 2026-08-06.

  No hay ni una clase de color cambiada dentro: `superficie-institucional` redefine la capa
  semántica en este subárbol, así que `text-foreground`, `text-muted-foreground` y
  `text-primary` siguen escritos igual y resuelven a los valores medidos para fondo azul.
  Ver la nota de esa clase en `global.css`.

  Se retira `bg-surface/60`, que era una superficie translúcida sobre el fondo de página, y
  también el `border-t`: una banda de color no necesita filete para separarse —lo hace con
  10,13:1 sobre el fondo claro—, y el filete heredado quedaba como una línea suelta.
-->
<footer class="superficie-institucional relative px-5 py-16 sm:px-8">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr]">
      <div class="min-w-0">
        <p class="font-display text-lg leading-snug font-semibold text-foreground">
          {c.title}
        </p>
        <p class="mt-3 max-w-md text-sm leading-relaxed text-muted-foreground">{c.subtitle}</p>
        <p class="eyebrow mt-6 text-muted-foreground">
          {c.dates.shortLabel} · {c.venue.city}, {c.venue.country}
        </p>
      </div>

      <div class="min-w-0">
        <h2 class="eyebrow text-muted-foreground">{c.ui.pie.contacto}</h2>
        <ul class="mt-4 space-y-3 text-sm text-muted-foreground">
          <li>
            <a
              href={`mailto:${c.contact.email}`}
              class="text-primary underline decoration-primary/40 underline-offset-4 transition-colors hover:decoration-primary"
            >
              {c.contact.email}
            </a>
          </li>
          <li class="leading-relaxed text-muted-foreground">{c.contact.school}</li>
        </ul>
      </div>

      <div class="min-w-0">
        <h2 class="eyebrow text-muted-foreground">{c.ui.pie.secciones}</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            c.nav.map((link) => (
              <li>
                <a href={link.href} class="text-muted-foreground transition-colors hover:text-primary">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-4 border-t hairline pt-8 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between"
    >
      <!-- Los nombres institucionales no se traducen: ver `src/data/comun.ts`. -->
      <p>© {year} {c.organizers[0].name} · {c.organizers[1].name}</p>
      <!--
        El espacio antes del código va explícito con `{' '}`, y no es cosmético: un salto de
        línea entre dos expresiones se colapsa a nada, así que la versión anterior imprimía
        «ProyectoFOVI250222» pegado. Se vio al capturar el pie sobre la banda azul el
        2026-08-06; llevaba ahí desde antes.

        La redacción de la mención sigue sin cumplir RNF-8.1 —falta el instrumento en la
        posición que ANID exige— y eso es otro asunto, pendiente con la agencia.
      -->
      <p class="font-mono">
        {c.ui.pie.financiadoPor} {c.funding.agency.shortName} · {c.ui.pie.proyecto}{' '}
        {c.funding.project.code}
      </p>
    </div>
  </div>
</footer>
