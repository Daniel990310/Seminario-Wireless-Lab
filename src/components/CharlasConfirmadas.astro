---
/**
 * Charlas confirmadas dentro de «Programa», cada una en un desplegable (RF-32).
 *
 * `<details>` nativo, como la reseña de `SpeakerCard` y el resumen de `ProgramaJornadas`:
 * se abre sin JavaScript y no carga ninguno. Rótulo y flecha son los de esos dos, para
 * que los tres desplegables de la página se lean igual. `lang="en"` en título y resumen:
 * el lector de pantalla los pronuncia en inglés también en la página española (el porqué
 * del inglés está en `charlas.ts`).
 */
import type { Contenido } from '~/data/contenido';

interface Props {
  c: Contenido;
  /** Con la parrilla publicada, la promesa de horarios sobra. */
  hasProgram: boolean;
}

const { c, hasProgram } = Astro.props;
const { charlas, ui } = c;
---

{
  charlas.length > 0 && (
    <div class="mt-14 border-t hairline pt-8" data-charlas>
      <h3 class="font-display text-xl font-semibold text-foreground sm:text-2xl">{ui.programa.charlas.titulo}</h3>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted-foreground">
        {ui.programa.charlas.nota}
        {!hasProgram && ` ${ui.programa.charlas.sinHorario}`}
      </p>
      <ul class="mt-6 divide-y divide-border border-y border-border">
        {charlas.map((charla) => (
          <li>
            <details class="desplegable-suave group">
              <summary class="group/fila block cursor-pointer list-none py-5 [&::-webkit-details-marker]:hidden">
                <span class="block text-sm font-semibold text-foreground">{charla.speaker}</span>
                <span class:list={['block text-sm text-muted-foreground', charla.affiliationPending && 'italic']}>
                  {charla.affiliation}
                </span>
                <span
                  lang="en"
                  class="mt-2 block font-display text-lg leading-snug text-foreground transition-colors group-hover/fila:text-primary"
                >
                  {charla.title}
                </span>
                <span class="mt-3 inline-flex items-center gap-2 text-sm text-primary underline decoration-primary/40 underline-offset-4 transition-colors group-hover/fila:decoration-primary">
                  {ui.programa.verResumen}
                  <svg
                    class="size-3 transition-transform group-open:rotate-180"
                    viewBox="0 0 12 12"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    aria-hidden="true"
                  >
                    <path d="M2.5 4.5 6 8l3.5-3.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
              </summary>
              <p lang="en" class="max-w-3xl pb-6 text-base leading-relaxed text-muted-foreground">
                {charla.abstract}
              </p>
            </details>
          </li>
        ))}
      </ul>
    </div>
  )
}
