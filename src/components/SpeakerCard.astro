---
import type { Speaker } from '~/data/seminar';

interface Props {
  speaker: Speaker;
  index: number;
}

const { speaker, index } = Astro.props;

// Iniciales como marca visual mientras no haya retratos disponibles.
const initials = speaker.name
  .split(' ')
  .filter((part) => part.length > 1)
  .slice(0, 2)
  .map((part) => part[0])
  .join('');
---

<article
  class="reveal surface relative flex flex-col gap-5 rounded-surface p-6"
  style={`transition-delay:${index * 70}ms`}
>
  <div class="flex items-start gap-4">
    <span
      class="grid size-12 shrink-0 place-items-center rounded-surface border border-primary/40 bg-primary/8 font-display text-sm font-semibold text-primary"
      aria-hidden="true"
    >
      {initials}
    </span>
    <div class="min-w-0">
      <h3 class="font-display text-lg leading-tight font-semibold text-foreground">
        {speaker.name}
      </h3>
      <p
        class:list={[
          'mt-1.5 text-sm leading-snug',
          speaker.affiliationPending ? 'text-muted-foreground italic' : 'text-muted-foreground',
        ]}
      >
        {speaker.affiliation}
      </p>
      {speaker.country && <p class="eyebrow mt-2 text-muted-foreground">{speaker.country}</p>}
    </div>
  </div>

  <span class="mt-auto h-px w-full bg-border" aria-hidden="true"></span>
</article>
