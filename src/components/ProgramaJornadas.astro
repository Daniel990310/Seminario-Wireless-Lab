---
/**
 * Programa por jornadas (RF-6).
 *
 * **Mejora progresiva, no pestañas a secas.** El HTML que sale del build son las
 * jornadas una debajo de otra, con su encabezado y su lista de sesiones: eso es
 * lo que ve quien no tiene JavaScript, y es contenido completo, no un
 * contenedor vacío. Solo si hay JavaScript el guion construye el `tablist`,
 * oculta los paneles inactivos y conecta el teclado.
 *
 * Lo exige RF-6.2: «las pestañas degradan a secciones consecutivas […] nada de
 * contenido que solo exista al hidratar».
 *
 * **Por qué no un componente del catálogo.** Se buscaron pestañas en 21st.dev
 * (2026-07-31): los ocho resultados eran React —`react-aria-components`,
 * Headless UI, shadcn— y **ninguno funciona sin hidratar**, así que ninguno
 * cumple RF-6.2. Lo que sí se tomó de fuera es el patrón ARIA de la guía de
 * la W3C (`WAI-ARIA APG`), que es la referencia de la que copian todos ellos:
 * roles `tablist`/`tab`/`tabpanel`, `aria-selected`, `aria-controls`,
 * `aria-labelledby`, `tabindex` móvil y flechas con Home y End.
 *
 * El resumen de cada sesión va en un `<details>` nativo, por lo mismo que la
 * ficha de expositor: se despliega sin JavaScript y cuesta 0 kB.
 */
import type { Contenido } from '~/data/contenido';

interface Props {
  c: Contenido;
}

const { c } = Astro.props;
const { program, ui } = c;
---

<div data-jornadas>
  <!--
    El `tablist` nace oculto y el guion lo revela. Al revés —nacer visible y
    ocultarlo si no hay JavaScript— dejaría pestañas muertas en pantalla para
    quien no lo tenga.
  -->
  <div
    role="tablist"
    aria-label={ui.programa.jornadas}
    data-tablist
    hidden
    class="flex flex-wrap gap-px overflow-hidden rounded-surface border border-border"
  >
    {
      program.days.map((day, i) => (
        <button
          type="button"
          role="tab"
          id={`jornada-tab-${i}`}
          aria-controls={`jornada-panel-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          class="flex-1 bg-surface px-5 py-4 text-left text-sm font-medium text-muted-foreground transition-colors hover:text-foreground aria-selected:bg-primary aria-selected:text-primary-foreground"
        >
          <span class="block font-display text-base">{day.label}</span>
          <!--
            Sin `opacity`: rebajar la opacidad de un texto que ya usa el color
            atenuado lo hundía bajo el umbral de contraste, y axe lo marcó. La
            jerarquía la dan el tamaño y la familia monoespaciada de `.eyebrow`.
          -->
          <span class="eyebrow mt-1 block text-current">{day.date}</span>
        </button>
      ))
    }
  </div>

  <div class="mt-10 space-y-12">
    {
      program.days.map((day, i) => (
        <section
          id={`jornada-panel-${i}`}
          data-panel
          aria-labelledby={`jornada-titulo-${i}`}
          class="reveal"
        >
          {/*
            El encabezado sigue en el documento cuando hay pestañas: se oculta a
            la vista con `sr-only` porque la pestaña ya dice lo mismo, pero se
            conserva para que el índice de encabezados no pierda un nivel y
            RNF-1.5 siga cumpliéndose.
          */}
          <header
            id={`jornada-titulo-${i}`}
            data-titulo
            class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b hairline pb-4"
          >
            <h3 class="font-display text-xl font-semibold text-foreground">{day.label}</h3>
            <p class="eyebrow text-muted-foreground">{day.date}</p>
          </header>

          <ul class="divide-y divide-border">
            {day.sessions.map((session) => (
              <li class="grid gap-1 py-4 sm:grid-cols-[7rem_1fr] sm:gap-6">
                <p class="font-mono text-sm text-primary">{session.time}</p>
                <div class="min-w-0">
                  <p class="text-base text-foreground">{session.title}</p>
                  {session.speaker && (
                    <p class="mt-1 text-sm text-muted-foreground">{session.speaker}</p>
                  )}

                  {/*
                    Solo las sesiones con resumen abren desplegable. Una pausa o
                    un almuerzo no lo tienen, y poner un control vacío sería
                    ruido: RF-6 pide que la interacción resuelva un problema de
                    lectura, no que exista.
                  */}
                  {session.summary && (
                    <details class="group mt-2">
                      <summary class="inline-flex cursor-pointer list-none items-center gap-2 text-sm text-primary underline decoration-primary/40 underline-offset-4 transition-colors hover:decoration-primary [&::-webkit-details-marker]:hidden">
                        {ui.programa.verResumen}
                        <svg
                          class="size-3 transition-transform group-open:rotate-180"
                          viewBox="0 0 12 12"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.8"
                          aria-hidden="true"
                        >
                          <path d="M2.5 4.5 6 8l3.5-3.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </summary>
                      <p class="mt-3 border-l-2 border-border pl-4 text-sm leading-relaxed text-muted-foreground">
                        {session.summary}
                      </p>
                    </details>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</div>

<script>
  /*
   * Convierte las jornadas apiladas en pestañas. Todo lo que hace este guion es
   * *añadir*: si no corre, quedan las secciones consecutivas, que es contenido
   * completo y navegable.
   *
   * Teclado según la guía de patrones de la W3C: flechas para moverse con vuelta
   * circular, Home y End a los extremos. Activación automática al mover el foco,
   * que la guía admite cuando mostrar un panel no cuesta nada, como aquí.
   */
  for (const grupo of document.querySelectorAll<HTMLElement>('[data-jornadas]')) {
    const tablist = grupo.querySelector<HTMLElement>('[data-tablist]');
    const tabs = [...grupo.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const paneles = [...grupo.querySelectorAll<HTMLElement>('[data-panel]')];

    // Con una sola jornada no hay nada entre lo que elegir.
    if (!tablist || tabs.length < 2 || tabs.length !== paneles.length) continue;

    tablist.hidden = false;

    const activar = (indice: number, moverFoco = true) => {
      tabs.forEach((tab, i) => {
        const activo = i === indice;
        tab.setAttribute('aria-selected', String(activo));
        tab.tabIndex = activo ? 0 : -1;
        paneles[i].hidden = !activo;
        // El título del panel sobra a la vista cuando la pestaña ya lo dice,
        // pero se conserva en el documento para los lectores de pantalla.
        paneles[i].querySelector('[data-titulo]')?.classList.add('sr-only');
      });
      if (moverFoco) tabs[indice].focus();
    };

    activar(0, false);

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => activar(i, false));

      tab.addEventListener('keydown', (evento) => {
        const ultimo = tabs.length - 1;
        const destino = {
          ArrowRight: i === ultimo ? 0 : i + 1,
          ArrowLeft: i === 0 ? ultimo : i - 1,
          Home: 0,
          End: ultimo,
        }[evento.key];

        if (destino === undefined) return;
        evento.preventDefault();
        activar(destino);
      });
    });
  }
</script>
