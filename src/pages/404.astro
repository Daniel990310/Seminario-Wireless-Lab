---
/**
 * Página de error 404 (RNF-7.6).
 *
 * Existe porque el sitio publicado devolvía `404` con **0 bytes**: el código HTTP
 * era correcto y la persona veía una página en blanco. Para un sitio que se difunde
 * por enlace, QR y programa impreso, una letra mal copiada no puede terminar en nada.
 *
 * **No usa `BaseLayout`** a propósito. Ese layout emite los datos estructurados del
 * `Event`, el enlace canónico, los `hreflang` y la imagen para compartir: todo eso
 * describe el seminario, y ponerlo en una página de error le dice al buscador que
 * esta URL inexistente ES el evento. Aquí solo se reutiliza lo que la página necesita
 * de verdad: el guion del tema, las tipografías y el sistema de diseño.
 *
 * **No redirige al inicio.** Un 302 a `/` produce un «soft 404», que Google trata
 * como duplicado del inicio. El código tiene que seguir siendo 404.
 *
 * **El texto va en los dos idiomas.** Un sitio estático sirve un único `404.html`
 * para cualquier ruta inexistente, en `/` o en `/en/`, y no hay nada en el borde que
 * pueda elegir sin un Worker. Ver la nota de RNF-7.6.
 */
import { Font } from 'astro:assets';
import { contenido } from '~/data/contenido';
import '~/styles/global.css';

const es = contenido('es');
const en = contenido('en');
const t = { es: es.ui.error404, en: en.ui.error404 };
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Mismo guion de tema que `BaseLayout`, por el mismo motivo (RF-4.2): en
         diferido el navegador pintaría claro y cambiaría después. -->
    <script is:inline>
      try {
        const guardado = localStorage.getItem('tema-seminario');
        const preferencia =
          guardado === 'dark' || guardado === 'light' || guardado === 'system'
            ? guardado
            : 'light';
        const oscuro =
          preferencia === 'dark' ||
          (preferencia === 'system' &&
            window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = oscuro ? 'dark' : 'light';
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    </script>

    <title>{`${t.es.tituloDocumento} — ${t.en.tituloDocumento}`}</title>
    <!-- Una página de error nunca se indexa, viva donde viva el sitio. -->
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#e9f0fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#03101f" media="(prefers-color-scheme: dark)" />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
  </head>

  <body class="bg-background text-foreground">
    <main class="mx-auto flex min-h-screen max-w-2xl flex-col justify-center gap-10 px-6 py-16">
      <p class="font-mono text-sm tracking-widest text-muted-foreground uppercase">
        {t.es.etiqueta}
      </p>

      <div class="flex flex-col gap-3">
        <h1 class="font-display text-4xl leading-tight text-balance sm:text-5xl">
          {t.es.titulo}
        </h1>
        <p class="text-lg text-muted-foreground text-pretty">
          {t.es.explicacion}
        </p>
        <a
          href="/"
          class="mt-2 inline-flex w-fit items-center rounded-control bg-primary px-5 py-2.5 font-medium text-primary-foreground"
        >
          {t.es.volver}
        </a>
      </div>

      <hr class="border-border" />

      <div class="flex flex-col gap-3" lang="en">
        <h2 class="font-display text-2xl leading-tight text-balance">{t.en.titulo}</h2>
        <p class="text-muted-foreground text-pretty">
          {t.en.explicacion}
        </p>
        <a
          href="/en/"
          class="mt-2 inline-flex w-fit items-center rounded-control border border-border-control px-5 py-2.5 font-medium"
        >
          {t.en.volver}
        </a>
      </div>

      <p class="mt-4 font-mono text-xs text-muted-foreground">
        {es.title} · {es.dates.shortLabel}
      </p>
    </main>
  </body>
</html>
