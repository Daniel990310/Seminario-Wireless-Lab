---
/** Lienzos de las piezas de difusión en redes. Ver `CartelFlyer.astro` y `src/data/flyer.ts`. */
import CartelFlyer from '~/components/CartelFlyer.astro';
import LaminaAcceso from '~/components/flyer/LaminaAcceso.astro';
import LaminaExpositores from '~/components/flyer/LaminaExpositores.astro';
import LaminaInscripcion from '~/components/flyer/LaminaInscripcion.astro';
import LaminaPendon from '~/components/flyer/LaminaPendon.astro';
import LaminaTelon from '~/components/flyer/LaminaTelon.astro';
import LaminaUnica from '~/components/flyer/LaminaUnica.astro';
import Portada from '~/components/flyer/Portada.astro';
import { altFlyer, datosFlyer, pieDePublicacion } from '~/components/flyer/datos';
import { contenido } from '~/data/contenido';
import { PIEZAS_FLYER, POR_LAMINA } from '~/data/flyer';

export function getStaticPaths() {
  return PIEZAS_FLYER.map(({ pieza, idioma, formato, lamina, pie, participantes }) => ({
    params: { pieza },
    props: { idioma, formato, lamina, pie, participantes },
  }));
}

const { idioma, formato, lamina, pie, participantes: conParticipantes } = Astro.props;
const c = contenido(idioma);

/* Qué componente dibuja cada lámina. La historia es la portada con hueco para el sticker. */
const COMPONENTE = {
  unica: LaminaUnica,
  portada: Portada,
  historia: Portada,
  expositores: LaminaExpositores,
  inscripcion: LaminaInscripcion,
  pendon: LaminaPendon,
  acceso: LaminaAcceso,
  telon: LaminaTelon,
} as const;
const Lamina = COMPONENTE[lamina];

/*
 * Lo que la lámina debe contener, para los criterios de `specs/003-difusion-redes`. Se
 * declara aquí, junto a la decisión de qué lámina es, y no se deduce del HTML.
 */
// Toda lámina lleva franja y agradecimiento; la fila de participantes, según `LAMINAS`.
const { dominio, organizador, participantes, mencion } = datosFlyer(c);
const esperado = {
  dominio,
  fecha: c.dates.shortLabel,
  organizador: POR_LAMINA[lamina].organizador ? organizador : null,
  marcas: ['pucv', 'eie', 'cyted', 'aps', 'anid'],
  mencion,
  participantes: conParticipantes ? participantes.map((p) => p.nombre) : [],
};
---

<CartelFlyer
  lang={idioma}
  formato={formato}
  alt={altFlyer(c, lamina)}
  pie={pie ? pieDePublicacion(c) : undefined}
  emisor={POR_LAMINA[lamina].emisor}
  esperado={esperado}
>
  <Lamina c={c} participantes={conParticipantes} historia={lamina === 'historia'} />
</CartelFlyer>
