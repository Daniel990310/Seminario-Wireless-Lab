---
/** Lienzos de las piezas de difusión en redes. Ver `CartelFlyer.astro` y `src/data/flyer.ts`. */
import CartelFlyer from '~/components/CartelFlyer.astro';
import LaminaAcceso from '~/components/flyer/LaminaAcceso.astro';
import LaminaExpositores from '~/components/flyer/LaminaExpositores.astro';
import LaminaInscripcion from '~/components/flyer/LaminaInscripcion.astro';
import LaminaPendon from '~/components/flyer/LaminaPendon.astro';
import LaminaTelon from '~/components/flyer/LaminaTelon.astro';
import LaminaUnica from '~/components/flyer/LaminaUnica.astro';
import Portada from '~/components/flyer/Portada.astro';
import { altFlyer, datosFlyer, pieDePublicacion } from '~/components/flyer/datos';
import { contenido } from '~/data/contenido';
import { PIEZAS_FLYER } from '~/data/flyer';

export function getStaticPaths() {
  return PIEZAS_FLYER.map(({ pieza, ...props }) => ({ params: { pieza }, props }));
}

const { idioma, formato, lamina, pie, emisor, organizador: nombraOrganizador, participantes: conParticipantes, qr } = Astro.props;
const c = contenido(idioma);

/* Qué componente dibuja cada lámina, con qué props. La historia es la portada con hueco para el sticker. */
const COMPONENTE = {
  unica: [LaminaUnica, {}],
  portada: [Portada, {}],
  historia: [Portada, { historia: true }],
  expositores: [LaminaExpositores, {}],
  inscripcion: [LaminaInscripcion, {}],
  pendon: [LaminaPendon, {}],
  acceso: [LaminaAcceso, {}],
  telon: [LaminaTelon, {}],
} as const;
const [Lamina, extra] = COMPONENTE[lamina];

/*
 * Lo que la lámina debe contener, para los criterios de `specs/003-difusion-redes`. Se
 * declara aquí, junto a la decisión de qué lámina es, y no se deduce del HTML.
 */
// Toda lámina lleva franja y agradecimiento; la fila de participantes, según `POR_LAMINA`.
const { dominio, organizador, participantes, mencion, urlPrograma } = datosFlyer(c);
// Una lámina que nombra al organizador sin organizador saldría con el nombre en blanco, y
// RF-25.2 no lo vería: esperaría `null`. Mejor que el build falle.
if (nombraOrganizador && !organizador) throw new Error(`[flyer] ${lamina}: el comité no trae organizador con grado de doctor`);
const esperado = {
  dominio,
  fecha: c.dates.shortLabel,
  organizador: nombraOrganizador ? organizador : null,
  marcas: ['pucv', 'eie', 'cyted', 'aps', 'anid'],
  mencion,
  participantes: conParticipantes ? participantes.map((p) => p.nombre) : [],
  qr: qr === 'registro' ? c.registro.url : qr === 'programa' ? urlPrograma : null,
};
---

<CartelFlyer
  lang={idioma}
  formato={formato}
  alt={altFlyer(c, lamina)}
  pie={pie ? pieDePublicacion(c) : undefined}
  emisor={emisor}
  esperado={esperado}
  participantes={conParticipantes}
>
  <Lamina c={c} {...extra} />
</CartelFlyer>
