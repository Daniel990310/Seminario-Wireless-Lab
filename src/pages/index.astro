---
import BaseLayout from '~/layouts/BaseLayout.astro';
import SiteHeader from '~/components/SiteHeader.astro';
import Hero from '~/components/Hero.astro';
import Section from '~/components/Section.astro';
import SpeakerCard from '~/components/SpeakerCard.astro';
import CollaborationNetwork from '~/components/CollaborationNetwork';
import ProgramPending from '~/components/ProgramPending.astro';
import LogoWall from '~/components/LogoWall.astro';
import VenueLocator from '~/components/VenueLocator.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import { seminar } from '~/data/seminar';

const { program, speakers, topics, venue, organizers, participants, funding, about } = seminar;
const hasProgram = program.days.length > 0;
---

<BaseLayout>
  <SiteHeader />

  <main>
    <Hero />

    <!-- El seminario -->
    <Section
      id="seminario"
      eyebrow="El seminario"
      title="Comunicación y detección sobre la misma infraestructura"
      lead={about.lead}
    >
      <div class="mt-14 grid gap-14 lg:grid-cols-[1.1fr_1fr] lg:gap-20">
        <div class="reveal space-y-6 text-base leading-relaxed text-muted-foreground sm:text-lg">
          {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <!-- Temas del seminario -->
        <ul class="grid gap-px overflow-hidden rounded-surface border border-border sm:grid-cols-2">
          {
            topics.map((topic, index) => (
              <li
                class="reveal bg-surface/60 p-5"
                style={`transition-delay:${index * 80}ms`}
              >
                <h3 class="font-display text-base font-semibold text-foreground">{topic.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{topic.description}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </Section>

    <!-- Programa -->
    <Section
      id="programa"
      eyebrow="Programa"
      title="Jornadas del 21 y 22 de octubre"
      lead={`${seminar.dates.label} · ${venue.name}`}
      tinted
    >
      <div class="mt-12">
        {
          hasProgram ? (
            <div class="space-y-10">
              {program.days.map((day) => (
                <article class="reveal">
                  <header class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b hairline pb-4">
                    <h3 class="font-display text-xl font-semibold text-foreground">{day.label}</h3>
                    <p class="eyebrow text-muted-foreground">{day.date}</p>
                  </header>
                  <ul class="divide-y divide-border">
                    {day.sessions.map((session) => (
                      <li class="grid gap-1 py-4 sm:grid-cols-[7rem_1fr] sm:gap-6">
                        <p class="font-mono text-sm text-primary">{session.time}</p>
                        <div>
                          <p class="text-base text-foreground">{session.title}</p>
                          {session.speaker && (
                            <p class="mt-1 text-sm text-muted-foreground">{session.speaker}</p>
                          )}
                        </div>
                      </li>
                    ))}
                  </ul>
                </article>
              ))}
            </div>
          ) : (
            /* Estado provisional: se reemplaza solo al poblar program.days */
            <div class="reveal">
              <ProgramPending />
            </div>
          )
        }
      </div>
    </Section>

    <!-- Expositores -->
    <Section
      id="expositores"
      eyebrow="Expositores"
      title="Investigadores participantes"
      lead="Especialistas en propagación, detección inalámbrica y arquitecturas de redes de próxima generación."
    >
      <div class="mt-14 space-y-14">
        <div>
          <h3 class="reveal eyebrow flex items-center gap-4 text-muted-foreground">
            <span>Expositores internacionales</span>
            <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
          </h3>
          <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {
              speakers.international.map((speaker, index) => (
                <SpeakerCard speaker={speaker} index={index} />
              ))
            }
          </div>
        </div>

        <div>
          <h3 class="reveal eyebrow flex items-center gap-4 text-muted-foreground">
            <span>Expositores nacionales</span>
            <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
          </h3>
          <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {
              speakers.national.map((speaker, index) => (
                <SpeakerCard speaker={speaker} index={index} />
              ))
            }
          </div>
        </div>
      </div>
    </Section>

    <!-- Red de colaboración: topología del seminario -->
    <Section
      id="red"
      eyebrow="Red de colaboración"
      title="Instituciones vinculadas"
      lead="El seminario articula grupos de investigación de Estados Unidos y Chile en torno a la Escuela de Ingeniería Eléctrica de la PUCV."
      tinted
    >
      <div class="reveal mt-14">
        <CollaborationNetwork client:visible />
      </div>
    </Section>

    <!-- Sede -->
    <Section id="sede" eyebrow="Sede" title="Auditorio de la Sede PUCV Santiago">
      <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
        <div class="reveal">
          <address class="space-y-1 text-base not-italic sm:text-lg">
            <p class="font-display text-lg font-semibold text-foreground">{venue.name}</p>
            <p class="text-muted-foreground">{venue.street}</p>
            <p class="text-muted-foreground">{venue.district}, {venue.city}</p>
            <p class="text-muted-foreground">{venue.country}</p>
          </address>

          <!-- Los enlaces a mapas viven en el panel localizador, a la derecha. -->
          <dl class="mt-10 grid gap-6 border-t hairline pt-8 sm:grid-cols-2">
            <div>
              <dt class="eyebrow text-muted-foreground">Fechas</dt>
              <dd class="mt-2 text-base text-foreground">{seminar.dates.label}</dd>
            </div>
            <div>
              <dt class="eyebrow text-muted-foreground">Consultas</dt>
              <dd class="mt-2 text-base">
                <a
                  href={`mailto:${seminar.contact.email}`}
                  class="text-primary underline decoration-primary/40 underline-offset-4 transition-colors hover:decoration-primary"
                >
                  {seminar.contact.email}
                </a>
              </dd>
            </div>
          </dl>
        </div>

        <div class="reveal">
          <VenueLocator />
        </div>
      </div>
    </Section>

    <!-- Organización, instituciones y financiamiento -->
    <Section
      id="organizacion"
      eyebrow="Organización"
      title="Organización y financiamiento"
    >
      <div class="mt-14 space-y-16">
        <div>
          <h3 class="reveal eyebrow flex items-center gap-4 text-muted-foreground">
            <span>Organizan</span>
            <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
          </h3>
          <div class="mt-8">
            <LogoWall institutions={organizers} size="lg" />
          </div>
          <ul class="mt-6 space-y-1 text-sm text-muted-foreground">
            {organizers.map((organizer) => <li>{organizer.name}</li>)}
          </ul>
        </div>

        <div>
          <h3 class="reveal eyebrow flex items-center gap-4 text-muted-foreground">
            <span>Instituciones participantes y colaboradoras</span>
            <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
          </h3>
          <div class="mt-8">
            <LogoWall institutions={participants} />
          </div>
          <ul class="mt-6 grid gap-1 text-sm text-muted-foreground sm:grid-cols-2">
            {participants.map((participant) => <li>{participant.name}</li>)}
          </ul>
        </div>

        <!-- Financiamiento: obligatorio dar crédito a ANID y al proyecto FOVI -->
        <div class="reveal surface rounded-surface p-7 sm:p-10">
          <h3 class="eyebrow text-muted-foreground">Financia</h3>
          <div class="mt-7 grid gap-8 sm:grid-cols-[auto_1fr] sm:items-center sm:gap-10">
            <a
              href={funding.agency.url}
              target="_blank"
              rel="noopener noreferrer"
              class="block opacity-80 transition-opacity hover:opacity-100"
              title={funding.agency.name}
            >
              <img
                src={funding.agency.logo}
                alt={funding.agency.name}
                class="h-14 w-auto object-contain sm:h-16"
                loading="lazy"
                decoding="async"
              />
            </a>
            <div>
              <p class="font-display text-base font-semibold text-foreground">
                {funding.agency.name} ({funding.agency.shortName})
              </p>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                Proyecto <span class="font-mono text-primary">{funding.project.code}</span>,
                <span class="italic"> {funding.project.name}</span>.
              </p>
            </div>
          </div>
        </div>
      </div>
    </Section>
  </main>

  <SiteFooter />
</BaseLayout>
