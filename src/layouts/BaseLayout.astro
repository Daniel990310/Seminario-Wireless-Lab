---
import { Font } from 'astro:assets';
import { PRODUCTION_HOST, SITE_ES_RESPALDO } from '../../astro.config.mjs';
import { IDIOMAS, rutaBase, type Contenido, type Idioma } from '~/data/contenido';
import { rutaOg } from '~/data/og';
import '~/styles/global.css';

interface Props {
  c: Contenido;
  title?: string;
  description?: string;
}

const { c } = Astro.props;
const seminar = c;
const lang = c.lang as Idioma;

const {
  title = `${c.title} — ${c.dates.shortLabel}`,
  description = c.seo.description,
} = Astro.props;

const sitio = Astro.site ?? 'https://example.com';
const canonical = new URL(Astro.url.pathname, sitio);

/*
 * `hreflang` recíproco más `x-default` (RF-1.4).
 *
 * `x-default` apunta al español porque es la versión de la institución que
 * organiza; es lo que debe recibir quien llega sin una preferencia declarada.
 * Cada idioma se enlaza a sí mismo además de al otro: así lo pide la
 * especificación, y omitir la autorreferencia es el error habitual.
 */
const alternativas = IDIOMAS.map((idioma) => ({
  hreflang: idioma,
  href: new URL(rutaBase(idioma), sitio).href,
}));
const xDefault = new URL(rutaBase('es'), sitio).href;

/** Locale de Open Graph. El español del sitio es de Chile. */
const ogLocale = lang === 'es' ? 'es_CL' : 'en_US';

/*
 * Imagen para compartir, una por idioma (RNF-3.2). Debe ser **absoluta**: las
 * plataformas que la consumen no resuelven rutas relativas.
 *
 * El archivo se genera con `npm run og` a partir de `/og/<idioma>/` y se
 * versiona en `public/`. Si cambia el título o la fecha, hay que regenerarlo:
 * `verify:og` avisa si las imágenes faltan o no miden 1200×630, pero no puede
 * saber si el texto de dentro quedó viejo.
 */
const ogImage = new URL(rutaOg(lang), sitio).href;

/*
 * Mientras el sitio viva en una URL de previsualización (*.pages.dev,
 * *.workers.dev, *.netlify.app) se pide a los buscadores que no lo indexen:
 * evita que la copia provisional compita con el dominio institucional
 * definitivo por el mismo contenido.
 *
 * La segunda condición es la salvaguarda: si **nadie declaró** la URL y el
 * build cayó al respaldo, no se indexa aunque el host coincida. Sin ella, un
 * despliegue sin `SITE_URL` se cree producción y pide ser indexado con enlaces
 * canónicos que apuntan a un dominio que quizá ni existe. Pasó el 2026-07-31
 * en el primer despliegue a Workers; ver `ESTADO.md` §6c.
 */
const isPreview = canonical.host !== PRODUCTION_HOST || SITE_ES_RESPALDO;

// Datos estructurados: permiten que buscadores y calendarios reconozcan
// el seminario como un evento con fecha y lugar.
const eventSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: seminar.title,
  alternateName: seminar.subtitle,
  description: seminar.seo.description,
  /*
   * `url` e `image` son recomendados por schema.org/Event, y sin `image` Google
   * no construye el resultado enriquecido de evento (RNF-3.6). Se reutilizan el
   * canónico y la imagen para compartir en vez de declarar valores propios: si
   * alguna vez divergieran, el buscador vería dos direcciones para la misma
   * página y una imagen que nadie mantiene.
   */
  url: canonical.href,
  image: ogImage,
  startDate: seminar.dates.startISO,
  endDate: seminar.dates.endISO,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  /*
   * Acceso gratuito (RNF-3.7). Google necesita LAS DOS cosas para mostrar el
   * distintivo «Gratis» en el resultado de evento: `isAccessibleForFree` y una
   * `Offer` con precio 0. Solo con la primera no lo construye.
   *
   * El dato sale de `comun.acceso` y no está escrito aquí: el día que el seminario
   * cobre, se cambia en los datos y esto deja de anunciar gratuidad solo. Un precio
   * viejo en un resultado de búsqueda es peor que no declarar precio.
   *
   * `priceCurrency` se declara aunque el precio sea 0 porque `schema.org/Offer` la
   * exige; sin ella el validador descarta la oferta entera y el distintivo no sale.
   */
  isAccessibleForFree: seminar.acceso.gratuito,
  offers: {
    '@type': 'Offer',
    price: seminar.acceso.precio,
    priceCurrency: seminar.acceso.moneda,
    availability: 'https://schema.org/InStock',
    /*
     * Opcional y no crítica para Google; se declara porque el dato existe. Ver la nota
     * de `comun.acceso.validoDesde`.
     */
    validFrom: seminar.acceso.validoDesde,
    /*
     * La URL de la oferta apunta al formulario de inscripción cuando existe (RF-3,
     * criterio 5), y a la página del seminario cuando no. Un buscador que muestre el
     * distintivo de evento enlaza esta dirección: si hay dónde inscribirse, llevar
     * ahí es lo correcto; si no lo hay, mandar a la propia página es preferible a
     * declarar una oferta sin destino.
     *
     * `??` basta porque `contenido.ts` ya normalizó la ausencia a `null`: aquí no hay
     * que volver a decidir qué cuenta como «no hay formulario».
     */
    url: seminar.registro.url ?? canonical.href,
  },
  location: {
    '@type': 'Place',
    name: seminar.venue.name,
    address: {
      '@type': 'PostalAddress',
      streetAddress: seminar.venue.street,
      addressLocality: seminar.venue.district,
      addressRegion: seminar.venue.city,
      addressCountry: 'CL',
    },
  },
  organizer: seminar.organizers.map((o) => ({
    '@type': 'Organization',
    name: o.name,
    url: o.url,
  })),
  funder: {
    '@type': 'Organization',
    name: seminar.funding.agency.name,
    alternateName: seminar.funding.agency.shortName,
  },
  // Las afiliaciones aún sin confirmar se omiten del schema en vez de
  // declararse como organización.
  performer: [...seminar.speakers.international, ...seminar.speakers.national].map((speaker) => ({
    '@type': 'Person',
    name: speaker.name,
    affiliation: speaker.affiliationPending
      ? undefined
      : { '@type': 'Organization', name: speaker.affiliation },
  })),
  inLanguage: lang,
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!--
      Tema antes del primer pintado (RF-4.2).

      Va en línea y lo más arriba posible del <head> a propósito: si se cargara
      como módulo diferido, el navegador pintaría el tema claro y lo cambiaría
      después, produciendo el destello que RF-4.2 prohíbe. `is:inline` evita que
      Astro lo procese y lo mueva.

      Sin JavaScript no se ejecuta y el sitio queda en claro, que es el valor por
      omisión de `:root` (RF-4.1 y RF-4.4).
    -->
    <script is:inline>
      try {
        const guardado = localStorage.getItem('tema-seminario');
        const preferencia =
          guardado === 'dark' || guardado === 'light' || guardado === 'system'
            ? guardado
            : 'light';
        const oscuro =
          preferencia === 'dark' ||
          (preferencia === 'system' &&
            window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = oscuro ? 'dark' : 'light';
      } catch {
        // localStorage puede fallar en modo privado: el tema claro por omisión sirve.
        document.documentElement.dataset.theme = 'light';
      }
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={seminar.seo.keywords.join(', ')} />
    <link rel="canonical" href={canonical.href} />

    <!-- Cada versión se enlaza a sí misma y a la otra, más `x-default` (RF-1.4). -->
    {alternativas.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <!--
      Marca propia del seminario (kit «Beyond Connectivity v5.2», 2026-09-22).
      Documentación: `specs/marca-beyond-connectivity.md`.

      El `/favicon.svg` anterior era un resto del diseño viejo: cian `#35d0e6` sobre
      `#05070f`, dos colores que el sitio **ya no usa desde T5**, cuando se retiró el
      cian por estridente. O sea que la pestaña del navegador mostraba una paleta que
      no existe en ninguna otra parte de la página.

      Tres entradas y no una, porque cada una cubre un caso que las otras no:
        - SVG: la que usan los navegadores actuales; nítida a cualquier tamaño.
        - ICO: Safari antiguo y accesos directos de escritorio en Windows, que no
          leen SVG. Trae 16, 32 y 48 px con una geometría **simplificada a mano**
          para 16 px —dos ondas en vez de tres—, porque el símbolo completo a ese
          tamaño se empasta.
        - `apple-touch-icon`: iOS al añadir a la pantalla de inicio. Sin ella, Safari
          recorta una captura de la página.
    -->
    <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/brand/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/brand/favicon-180.png" sizes="180x180" />
    <!--
      Se declara por tema para que la barra del navegador móvil acompañe.

      Estos dos valores son copias de `--slate-50` y `--ink-900` de `global.css`, y no hay
      forma de evitarlo: `<meta>` no admite `var()`. Es el único sitio del proyecto donde un
      color de la paleta se repite a pelo, así que **al cambiar esos dos primitivos hay que
      cambiarlos aquí**. Se actualizaron el 2026-08-06 al teñir la rampa con el azul PUCV;
      antes decían `#f8fafc` y `#0a1020`.
    -->
    <meta name="theme-color" content="#e9f0fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#03101f" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${c.tituloCorto} — ${c.organizers[0].shortName}`} />
    <meta property="og:title" content={seminar.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={`${c.title} — ${c.dates.label}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seminar.title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-mono" />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} is:inline />
  </head>

  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-control focus:bg-primary focus:px-4 focus:py-2 focus:font-medium focus:text-primary-foreground"
    >
      {c.ui.saltarAlContenido}
    </a>

    <slot />

    <script>
      // Aparición progresiva de secciones al entrar en pantalla.
      const targets = document.querySelectorAll<HTMLElement>('.reveal');

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && targets.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.05 },
        );

        for (const target of targets) observer.observe(target);
      } else {
        for (const target of targets) target.classList.add('is-visible');
      }
    </script>
  </body>
</html>
